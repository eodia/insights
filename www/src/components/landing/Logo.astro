---
interface Props {
	/** The wordmark's colour: dark on light backgrounds, light on dark ones. */
	tone?: 'dark' | 'light';
	size?: number;
}
const { tone = 'dark', size = 26 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span class:list={['bd-logo', tone]} style={`--bd-logo-size: ${size}px`}>
	<img src={`${base}/brand/mark.svg`} width={size} height={size} alt="" />
	<span class="word" translate="no">eodia <b>insights</b></span>
</span>

<style>
	.bd-logo {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		line-height: 1;
	}
	.bd-logo img {
		width: var(--bd-logo-size);
		height: var(--bd-logo-size);
		flex-shrink: 0;
	}
	.word {
		font-size: calc(var(--bd-logo-size) * 0.72);
		font-weight: 500;
		letter-spacing: -0.04em;
		color: #3f4a42;
		white-space: nowrap;
	}
	.word b {
		font-weight: 800;
		color: #0f2a1c;
	}
	.light .word {
		color: #b9c7bb;
	}
	.light .word b {
		color: #f4f8ef;
	}
</style>

---
/**
 * One engine, every base. Seven sources on the left send their lines to Trino, in the
 * middle; Trino sends one result to the right — and under it, the query that did it,
 * joining PostgreSQL and MongoDB as two tables of the same base.
 *
 * When the scene comes into view the lines draw themselves, the hub lights up, and data
 * keeps flowing along them (`offset-path`) while it stays on screen. Drawn at 1080 × 440
 * and scaled to its frame.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, lang } = i18n(locale);
const e = t.engine;

const SOURCES = [
	{ name: 'PostgreSQL', short: 'Pg', color: '#4f8fd6' },
	{ name: 'MySQL', short: 'My', color: '#f29111' },
	{ name: 'SQL Server', short: 'MS', color: '#e04a3f' },
	{ name: 'Oracle', short: 'Or', color: '#f05a5a' },
	{ name: 'Snowflake', short: '❄', color: '#29b5e8' },
	{ name: 'MongoDB', short: 'Mg', color: '#3fcf5e' },
	{ name: 'Trino', short: 'Tr', color: '#e84fb5' },
];
const HUB = { x: 540, y: 220 };
const sources = SOURCES.map((src, i) => {
	const y = 34 + i * 62;
	const d = `M246 ${y} C 360 ${y}, 380 ${HUB.y}, ${HUB.x - 96} ${HUB.y}`;
	return { ...src, y, d, i };
});
const OUT = `M${HUB.x + 96} ${HUB.y} C 700 ${HUB.y}, 700 ${HUB.y}, 776 ${HUB.y}`;

const money = (n: number) => new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR' }).format(n);
const number = (n: number) => new Intl.NumberFormat(lang).format(n);
const ROWS: Array<[string, number, number]> = [
	[t.stage.regions[0]!, 92.4, 1284],
	[t.stage.regions[1]!, 88.1, 702],
	[t.stage.regions[2]!, 86.7, 498],
	[t.stage.regions[3]!, 91.2, 311],
];

const kw = (w: string) => `<span class="k">${w}</span>`;
const fn = (w: string) => `<span class="f">${w}</span>`;
const pg = (w: string) => `<span class="pg">${w}</span>`;
const mg = (w: string) => `<span class="mg">${w}</span>`;
const SQL = [
	`${kw('select')} c.region,`,
	`       ${fn('avg')}(o.montant_total) ${kw('as')} panier_moyen,`,
	`       ${fn('count')}(t.ticket_id)   ${kw('as')} tickets`,
	`  ${kw('from')} ${pg('boutique.public.commandes')} o`,
	`  ${kw('join')} ${pg('boutique.public.clients')} c ${kw('on')} c.id = o.client_id`,
	`  ${kw('left join')} ${mg('support.support.tickets')} t ${kw('on')} t.client_id = c.id`,
	` ${kw('group by')} c.region`,
].join('\n');
---

<section class="tm-section night engine" data-engine>
	<div class="tm-head">
		<p class="tm-kicker tm-rise">{e.kicker}</p>
		<h2 class="tm-display tm-rise">
			<span>{e.title}</span>
			<span class="tm-grad">{e.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{e.lede}</p>
	</div>

	<div class="scene tm-rise" data-scene aria-hidden="true">
		<div class="canvas">
			<svg class="wires" viewBox="0 0 1080 440">
				<defs>
					<radialGradient id="en-core" cx="50%" cy="45%" r="60%">
						<stop offset="0" stop-color="#1f3a28"></stop>
						<stop offset="1" stop-color="#0b120d"></stop>
					</radialGradient>
					<linearGradient id="en-out" x1="0" x2="1">
						<stop offset="0" stop-color="#5fe07a"></stop>
						<stop offset="1" stop-color="#c9f06b"></stop>
					</linearGradient>
				</defs>
				{sources.map((s) => <path d={s.d} class="wire" pathLength="1" style={`--c:${s.color};--i:${s.i}`} />)}
				<path d={OUT} class="wire out" pathLength="1" style="--i:8"></path>
				<circle cx={HUB.x} cy={HUB.y} r="128" class="halo"></circle>
				<circle cx={HUB.x} cy={HUB.y} r="112" class="orbit"></circle>
				<circle cx={HUB.x} cy={HUB.y} r="96" class="core" fill="url(#en-core)"></circle>
			</svg>

			{
				sources.map((s) => (
					<>
						<div class="src" style={`top:${s.y - 22}px;--c:${s.color};--i:${s.i}`}>
							<span class="logo">{s.short}</span>
							{s.name}
						</div>
						<i class="spark" style={`offset-path:path('${s.d}');--c:${s.color};--d:${(s.i * 0.37) % 1.6}s`} />
					</>
				))
			}
			<i class="spark out" style={`offset-path:path('${OUT}');--c:#c9f06b;--d:0.2s`}></i>
			<i class="spark out" style={`offset-path:path('${OUT}');--c:#c9f06b;--d:1.1s`}></i>

			<div class="hub" style={`left:${HUB.x}px;top:${HUB.y}px`}>
				<b>{e.hub}</b>
				<small>{e.hubSub}</small>
			</div>

			<div class="result">
				<p class="r-head">
					<b>{e.result}</b>
					<small>{e.resultSub}</small>
				</p>
				{
					ROWS.map(([region, basket, tickets], i) => (
						<div class="r-row" style={`--i:${i}`}>
							<span>{region}</span>
							<span>{money(basket)}</span>
							<span>{number(tickets)}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<pre class="query tm-rise" aria-label="SQL"><code set:html={SQL} /></pre>

	<div class="tm-points">
		{
			e.points.map((p, i) => (
				<div class="tm-rise" style={`transition-delay:${i * 0.08}s`}>
					<span class="ic">
						{i === 0 && (
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m8 9-3 3 3 3M16 9l3 3-3 3M13.5 6l-3 12" /></svg>
						)}
						{i === 1 && (
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg>
						)}
						{i === 2 && (
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
						)}
					</span>
					<h3>{p.title}</h3>
					<p>{p.text}</p>
				</div>
			))
		}
	</div>
	<p class="more tm-rise"><a class="tm-link" href={href('/fonctionnalites/sources/')}>{e.link}</a></p>
</section>

<script>
	import { fit } from '../../lib/motion';

	const section = document.querySelector<HTMLElement>('[data-engine]');
	const scene = section?.querySelector<HTMLElement>('[data-scene]');
	if (section && scene) {
		fit(scene, 1080, 0.3);
		new IntersectionObserver(
			([entry]) => {
				if (entry?.isIntersecting) scene.dataset.on = '';
				// The sparks only run while they can be seen.
				scene.toggleAttribute('data-live', entry?.isIntersecting === true);
			},
			{ threshold: 0.35 },
		).observe(scene);
	}
</script>

<style>
	.engine {
		overflow: hidden;
	}
	.engine::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 38%;
		width: 900px;
		height: 900px;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgba(63, 203, 42, 0.12), transparent);
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.scene {
		--k: 1;
		position: relative;
		max-width: 1080px;
		height: calc(440px * var(--k));
		margin: 72px auto 0;
	}
	.canvas {
		position: absolute;
		top: 0;
		left: 50%;
		width: 1080px;
		height: 440px;
		transform: translateX(-50%) scale(var(--k));
		transform-origin: 50% 0;
	}
	.wires {
		position: absolute;
		inset: 0;
		width: 1080px;
		height: 440px;
		overflow: visible;
	}
	.wire {
		fill: none;
		stroke: var(--c);
		stroke-width: 2;
		stroke-opacity: 0.55;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 1.1s cubic-bezier(0.4, 0, 0.2, 1) calc(0.2s + var(--i) * 0.09s);
	}
	.wire.out {
		stroke: url(#en-out);
		stroke-width: 3;
		stroke-opacity: 1;
		transition-delay: 1.3s;
	}
	[data-on] .wire {
		stroke-dashoffset: 0;
	}
	.core {
		stroke: rgba(95, 224, 122, 0.35);
		stroke-width: 1.5;
		transition: stroke 0.8s ease 1s;
	}
	[data-on] .core {
		stroke: rgba(95, 224, 122, 0.9);
	}
	.orbit {
		fill: none;
		stroke: rgba(95, 224, 122, 0.35);
		stroke-width: 1.5;
		stroke-dasharray: 3 9;
		transform-origin: 540px 220px;
		animation: en-spin 30s linear infinite;
	}
	.halo {
		fill: rgba(63, 203, 42, 0.08);
		opacity: 0;
		transform-origin: 540px 220px;
		transform: scale(0.8);
		transition:
			opacity 1s ease 1s,
			transform 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) 1s;
	}
	[data-on] .halo {
		opacity: 1;
		transform: none;
		animation: en-breathe 4s ease-in-out 2.4s infinite;
	}
	@keyframes en-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes en-breathe {
		50% {
			transform: scale(1.06);
			opacity: 0.6;
		}
	}

	.src {
		position: absolute;
		left: 40px;
		display: flex;
		align-items: center;
		gap: 10px;
		width: 206px;
		height: 44px;
		padding: 0 12px 0 8px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		font-size: 14.5px;
		font-weight: 600;
		color: #f5f5f7;
		background: rgba(255, 255, 255, 0.04);
		backdrop-filter: blur(6px);
		opacity: 0;
		transform: translateX(-16px);
		transition:
			opacity 0.5s ease calc(var(--i) * 0.07s),
			transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.07s),
			border-color 0.3s ease;
	}
	[data-on] .src {
		opacity: 1;
		transform: none;
	}
	.src:hover {
		border-color: var(--c);
	}
	.logo {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		font-size: 12px;
		font-weight: 800;
		color: #0b0b0d;
		background: var(--c);
		box-shadow: 0 0 18px -2px var(--c);
	}

	.spark {
		position: absolute;
		top: 0;
		left: 0;
		width: 8px;
		height: 8px;
		margin: -4px 0 0 -4px;
		border-radius: 50%;
		background: var(--c);
		box-shadow:
			0 0 10px 2px var(--c),
			0 0 22px 4px color-mix(in srgb, var(--c) 40%, transparent);
		offset-rotate: 0deg;
		opacity: 0;
	}
	[data-live] .spark {
		animation: en-flow 1.9s cubic-bezier(0.5, 0, 0.5, 1) calc(1.5s + var(--d)) infinite;
	}
	[data-live] .spark.out {
		animation-duration: 1.8s;
		animation-delay: calc(2s + var(--d));
	}
	@keyframes en-flow {
		0% {
			offset-distance: 0%;
			opacity: 0;
		}
		15%,
		80% {
			opacity: 1;
		}
		100% {
			offset-distance: 100%;
			opacity: 0;
		}
	}

	.hub {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: translate(-50%, -50%);
		text-align: center;
	}
	.hub b {
		font-size: 34px;
		font-weight: 800;
		letter-spacing: -0.04em;
		background: var(--tm-grad-night);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.hub small {
		font-size: 13px;
		color: var(--tm-night-slate);
	}

	.result {
		position: absolute;
		left: 780px;
		top: 220px;
		width: 280px;
		padding: 14px 0 8px;
		border: 1px solid rgba(201, 240, 107, 0.3);
		border-radius: 16px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
		box-shadow: 0 30px 60px -30px rgba(95, 224, 122, 0.4);
		opacity: 0;
		transform: translate(20px, -50%);
		transition:
			opacity 0.6s ease 1.9s,
			transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 1.9s;
	}
	[data-on] .result {
		opacity: 1;
		transform: translate(0, -50%);
	}
	.r-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin: 0 0 8px;
		padding: 0 16px;
	}
	.r-head b {
		font-size: 15px;
		color: #fff;
	}
	.r-head small {
		font-size: 12px;
		color: #c9f06b;
	}
	.r-row {
		display: grid;
		grid-template-columns: 1.5fr 1fr 0.7fr;
		gap: 8px;
		padding: 7px 16px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		font-size: 12.5px;
		color: #d2d2d7;
		font-variant-numeric: tabular-nums;
		opacity: 0;
		transition: opacity 0.4s ease calc(2.2s + var(--i) * 0.1s);
	}
	.r-row span {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.r-row span + span {
		text-align: right;
	}
	[data-on] .r-row {
		opacity: 1;
	}

	.query {
		max-width: 760px;
		margin: 56px auto 0;
		padding: 24px 28px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 20px;
		font-size: 14px;
		line-height: 1.8;
		color: #d2d2d7;
		background: var(--tm-night-2);
		overflow-x: auto;
		box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
	}
	.query :global(.k) {
		color: #c4a5f5;
	}
	.query :global(.f) {
		color: #f2d675;
	}
	.query :global(.pg) {
		color: #8cc0ff;
		font-weight: 600;
	}
	.query :global(.mg) {
		color: #6ee08a;
		font-weight: 600;
	}
	.engine .tm-points h3 {
		color: #f5f5f7;
	}
	.more {
		margin: 48px 0 0;
		text-align: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit,
		[data-on] .halo,
		[data-live] .spark {
			animation: none;
		}
	}
</style>

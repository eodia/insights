---
/**
 * The window of the home page's story: eodia insights, drawn as the application draws it —
 * its sidebar, its bar, and four moments of the same afternoon on the demo shop: a question
 * built without SQL, the SQL editor joining PostgreSQL and MongoDB, the Copilot asked
 * about the chart, the dashboard where it all ends up.
 *
 * The `data-view` its parent writes (`builder`, `sql`, `copilot`, `dashboard`) picks what
 * shows; CSS does the rest — bars that grow, a curve that draws itself, cards that rise.
 * Without JavaScript, the question. Drawn at a fixed size, 1080 × 600, and scaled to the
 * width it is given.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
	/** The smallest scale: under it, the window is cut on the right rather than shrunk. */
	minScale?: number;
}

const { locale, minScale = 0.5 } = Astro.props;
const { t, lang } = i18n(locale);
const s = t.stage;

const money = (n: number, compact = false) =>
	new Intl.NumberFormat(lang, {
		style: 'currency',
		currency: 'EUR',
		...(compact ? { notation: 'compact', maximumFractionDigits: 0 } : { maximumFractionDigits: 2, minimumFractionDigits: 2 }),
	}).format(n);
const number = (n: number, digits = 0) => new Intl.NumberFormat(lang, { maximumFractionDigits: digits, minimumFractionDigits: digits }).format(n);

/** Revenue by channel: the question's bars, and the dashboard's ring. */
const CHANNELS = [612_400, 438_150, 231_900];
const CHANNEL_COLORS = ['#2da31e', '#14b8a6', '#a3d93a'];
const TOP = Math.max(...CHANNELS);
const channels = s.channels.map((label, i) => ({
	label,
	value: money(CHANNELS[i]!, true),
	height: Math.round((CHANNELS[i]! / TOP) * 100),
	color: CHANNEL_COLORS[i]!,
}));
const total = CHANNELS.reduce((a, b) => a + b, 0);
let offset = 0;
const ring = channels.map((c, i) => {
	const share = (CHANNELS[i]! / total) * 100;
	const arc = { ...c, share: share - 0.8, offset: -offset, percent: number(share) };
	offset += share;
	return arc;
});

/** The SQL editor's result: one line per region. */
const REGION_FACTS: Array<[number, number, number]> = [
	[92.4, 1284, 4.5],
	[88.1, 702, 4.6],
	[86.7, 498, 4.4],
	[91.2, 421, 4.7],
	[84.9, 402, 4.5],
	[83.5, 377, 4.3],
];
const regions = s.regions.map((name, i) => {
	const [basket, tickets, score] = REGION_FACTS[i]!;
	return { name, basket: money(basket), tickets: number(tickets), score: number(score, 1), bar: Math.round((tickets / 1284) * 100) };
});

/** The dashboard's curve: thirteen weeks of revenue, drawn in a 520 × 180 box. */
const WEEKS = [72, 78, 74, 86, 91, 88, 97, 104, 99, 112, 118, 115, 128];
const LO = 60;
const HI = 135;
const points = WEEKS.map((v, i) => [Math.round((i / (WEEKS.length - 1)) * 500 + 10), Math.round(170 - ((v - LO) / (HI - LO)) * 160)] as const);
const line = points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x} ${y}`).join(' ');
const area = `${line} L510 180 L10 180 Z`;
const last = points[points.length - 1]!;

/** The SQL, as the editor colours it. */
const kw = (w: string) => `<span class="k">${w}</span>`;
const fn = (w: string) => `<span class="f">${w}</span>`;
const id = (w: string) => `<span class="i">${w}</span>`;
const SQL = [
	`${kw('select')} c.region,`,
	`       ${fn('avg')}(o.montant_total) ${kw('as')} panier_moyen,`,
	`       ${fn('count')}(t.ticket_id)   ${kw('as')} tickets,`,
	`       ${fn('avg')}(t.satisfaction)  ${kw('as')} satisfaction`,
	`  ${kw('from')} ${id('boutique')}.public.commandes o`,
	`  ${kw('join')} ${id('boutique')}.public.clients c ${kw('on')} c.id = o.client_id`,
	`  ${kw('left join')} ${id('support')}.support.tickets t ${kw('on')} t.client_id = c.id`,
	` ${kw('group by')} c.region ${kw('order by')} tickets ${kw('desc')}`,
];

const nav = [
	{ key: 'home', show: '', icon: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>' },
	{ key: 'browse', show: 'builder copilot dashboard', icon: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' },
	{ key: 'sql', show: 'sql', icon: '<path d="m8 9-3 3 3 3M16 9l3 3-3 3M13.5 6l-3 12"/>' },
	{ key: 'data', show: '', icon: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>' },
	{ key: 'history', show: '', icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/>' },
] as const;
const FOLDER_COLORS = ['#71717a', '#2da31e', '#8b5cf6', '#f59e0b'];
const titles = [
	{ view: 'builder copilot', text: s.builder.title },
	{ view: 'sql', text: s.sql.title },
	{ view: 'dashboard', text: s.dashboard.title },
];
---

<div class="frame" data-frame data-min={minScale}>
	<div class="stage" data-stage data-view="builder">
		<div class="chrome" aria-hidden="true">
			<div class="dots"><i></i><i></i><i></i></div>
			<span class="url">{s.url}</span>
		</div>

		<!-- The sidebar -->
		<aside class="side" aria-hidden="true">
			<div class="ws">
				<span class="mark">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M5 18v-5M10 18V7M15 18v-8M20 18v-3"></path></svg>
				</span>
				<span class="who"><b>{s.workspace}</b><small>{s.workspaceSub}</small></span>
			</div>
			<ul class="nav">
				{
					nav.map((n) => (
						<li data-on={n.show || undefined}>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={n.icon} />
							{s.nav[n.key]}
						</li>
					))
				}
			</ul>
			<p class="side-title">{s.folders}</p>
			<ul class="nav folders">
				{
					s.folderNames.map((name, i) => (
						<li data-on={i === 1 ? 'builder copilot dashboard' : undefined}>
							<i style={`--c:${FOLDER_COLORS[i]}`} />
							{name}
						</li>
					))
				}
			</ul>
			<div class="me">
				<span class="avatar">AM</span>
				<span class="who"><b>Alice Martin</b><small>admin@exemple.fr</small></span>
			</div>
		</aside>

		<!-- The bar -->
		<header class="top" aria-hidden="true">
			<div>
				<small>{s.breadcrumb}</small>
				<span class="stack">
					{titles.map((ti) => <b data-show={ti.view}>{ti.text}</b>)}
				</span>
			</div>
			<div class="top-end">
				<span class="btn ghost" data-show="builder copilot">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path></svg>
					{s.copilot.title}
				</span>
				<span class="btn green" data-show="builder copilot">{s.builder.save}</span>
				<span class="btn green" data-show="sql">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4v16l13-8z"></path></svg>
					{s.sql.run}
				</span>
				<span class="chip" data-show="dashboard"><i></i>{s.dashboard.refresh}</span>
			</div>
		</header>

		<!-- 1. The question, without SQL -->
		<section class="pane builder" data-show="builder copilot" aria-hidden="true">
			<div class="notebook">
				<div class="step">
					<p>{s.builder.data}</p>
					<span class="pill blue">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 3v18"></path></svg>
						{s.builder.table}
					</span>
				</div>
				<div class="step">
					<p>{s.builder.filter}</p>
					<span class="pill violet">{s.builder.filterValue}</span>
				</div>
				<div class="step">
					<p>{s.builder.summarize}</p>
					<div class="row">
						<span class="pill green">{s.builder.metric}</span>
						<span class="by">{s.builder.by}</span>
						<span class="pill green">{s.builder.group}</span>
					</div>
				</div>
				<span class="visualize">{s.builder.visualize}</span>
			</div>
			<div class="card chart">
				<p class="card-title">{s.builder.title}</p>
				<div class="bars">
					{
						channels.map((c, i) => (
							<div class="bar" style={`--h:${c.height}%;--i:${i};--c:${c.color}`} data-hot={i === 1 ? '' : undefined}>
								<span class="val">{c.value}</span>
								<i />
								<span class="lab">{c.label}</span>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- 2. The SQL editor -->
		<section class="pane sql" data-show="sql" aria-hidden="true">
			<div class="editor">
				<ol>
					{SQL.map((l) => <li set:html={l} />)}
				</ol>
				<span class="caret"></span>
			</div>
			<div class="card result">
				<div class="result-head">
					{s.sql.columns.map((c, i) => <span class:list={[i > 0 && 'num']}>{c}</span>)}
				</div>
				{
					regions.map((r, i) => (
						<div class="result-row" style={`--i:${i}`}>
							<span>{r.name}</span>
							<span class="num">{r.basket}</span>
							<span class="num tick">
								<i style={`--w:${r.bar}%`} />
								{r.tickets}
							</span>
							<span class="num">{r.score}</span>
						</div>
					))
				}
				<p class="foot">{s.sql.rows}</p>
			</div>
		</section>

		<!-- 3. The Copilot, beside the question -->
		<aside class="pane copilot" data-show="copilot" aria-hidden="true">
			<p class="cp-head">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path></svg>
				{s.copilot.title}
			</p>
			<p class="ask">{s.copilot.ask}</p>
			<ul class="cp-steps">
				{
					s.copilot.steps.map((step, i) => (
						<li style={`--i:${i}`}>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
							{step}
						</li>
					))
				}
			</ul>
			<p class="answer" set:html={s.copilot.answer} />
			<span class="btn green apply">{s.copilot.apply}</span>
			<span class="prompt">{s.copilot.placeholder}</span>
		</aside>

		<!-- 4. The dashboard -->
		<section class="pane dash" data-show="dashboard" aria-hidden="true">
			<div class="filters">
				{
					s.dashboard.filters.map((f) => (
						<span class="filter">
							{f}
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="m6 9 6 6 6-6" /></svg>
						</span>
					))
				}
			</div>
			<div class="kpis">
				{
					s.dashboard.kpis.map((k, i) => (
						<div class="card kpi" style={`--i:${i}`}>
							<small>{k.label}</small>
							<b>{k.value}</b>
							<em>{k.delta}</em>
						</div>
					))
				}
			</div>
			<div class="card trend" style="--i:4">
				<p class="card-title">{s.dashboard.trend}</p>
				<svg viewBox="0 0 520 190" preserveAspectRatio="none">
					<defs>
						<linearGradient id="st-area" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#2da31e" stop-opacity="0.28"></stop>
							<stop offset="1" stop-color="#2da31e" stop-opacity="0"></stop>
						</linearGradient>
					</defs>
					{[40, 85, 130].map((y) => <line x1="10" x2="510" y1={y} y2={y} class="grid" />)}
					<path d={area} class="area" fill="url(#st-area)"></path>
					<path d={line} class="line" pathLength="1"></path>
					<circle cx={last[0]} cy={last[1]} r="5" class="dot"></circle>
				</svg>
			</div>
			<div class="card ring" style="--i:5">
				<p class="card-title">{s.dashboard.channels}</p>
				<div class="ring-body">
					<svg viewBox="0 0 42 42">
						<circle cx="21" cy="21" r="15.9" class="track"></circle>
						{ring.map((r, i) => <circle cx="21" cy="21" r="15.9" pathLength="100" class="arc" style={`--c:${r.color};--share:${r.share};--off:${r.offset};--i:${i}`} />)}
					</svg>
					<ul>
						{
							ring.map((r) => (
								<li>
									<i style={`--c:${r.color}`} />
									{r.label}
									<b>{r.percent} %</b>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<div class="card regions" style="--i:6">
				{
					regions.slice(0, 4).map((r, i) => (
						<div class="reg" style={`--w:${r.bar}%;--j:${i}`}>
							<span>{r.name}</span>
							<i />
						</div>
					))
				}
			</div>
		</section>
	</div>
</div>

<script>
	import { fit } from '../../lib/motion';

	for (const frame of document.querySelectorAll<HTMLElement>('[data-frame]')) {
		fit(frame, 1080, Number(frame.dataset.min ?? 0.5));
	}
</script>

<style>
	.frame {
		--k: 1;
		--ink: #18181b;
		--soft: #71717a;
		--line: #e4e4e7;
		--tint: #f4f4f5;
		--green: #2da31e;
		position: relative;
		width: 100%;
		max-width: 1080px;
		height: calc(600px * var(--k));
		margin: 0 auto;
		overflow: hidden;
		border-radius: calc(14px * var(--k));
		background: #fff;
		box-shadow: var(--bd-shadow-lg);
		border: 1px solid rgba(16, 24, 16, 0.1);
	}
	.stage {
		position: absolute;
		top: 0;
		left: 0;
		width: 1080px;
		height: 600px;
		transform: scale(var(--k));
		transform-origin: 0 0;
		font-family: var(--bd-font-sans);
		font-size: 13px;
		color: var(--ink);
		background: #fafafa;
	}
	.stage p {
		margin: 0;
	}
	.stage ul,
	.stage ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stack {
		display: inline-grid;
	}
	.stack > * {
		grid-area: 1 / 1;
	}

	/* What each view shows: everything that belongs to some views carries `data-show`. */
	[data-show] {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.5s ease,
			visibility 0.5s,
			transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.stage[data-view='builder'] [data-show~='builder'],
	.stage[data-view='sql'] [data-show~='sql'],
	.stage[data-view='copilot'] [data-show~='copilot'],
	.stage[data-view='dashboard'] [data-show~='dashboard'] {
		opacity: 1;
		visibility: visible;
	}
	.pane {
		position: absolute;
		top: 84px;
		left: 200px;
		right: 0;
		bottom: 0;
		padding: 16px;
		transform: translateY(14px) scale(0.985);
	}
	.stage[data-view='builder'] .pane[data-show~='builder'],
	.stage[data-view='sql'] .pane[data-show~='sql'],
	.stage[data-view='copilot'] .pane[data-show~='copilot'],
	.stage[data-view='dashboard'] .pane[data-show~='dashboard'] {
		transform: none;
	}

	/* The window */
	.chrome {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 3;
		display: flex;
		align-items: center;
		height: 30px;
		padding: 0 14px;
		border-bottom: 1px solid var(--line);
		background: #f4f4f5;
	}
	.dots {
		display: flex;
		gap: 6px;
	}
	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #ff5f57;
	}
	.dots i:nth-child(2) {
		background: #febc2e;
	}
	.dots i:nth-child(3) {
		background: #28c840;
	}
	.url {
		position: absolute;
		left: 50%;
		padding: 2px 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		font-size: 11px;
		color: var(--soft);
		background: #fff;
		transform: translateX(-50%);
	}

	/* The sidebar */
	.side {
		position: absolute;
		top: 30px;
		left: 0;
		bottom: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		width: 200px;
		padding: 12px 10px 10px;
		border-right: 1px solid var(--line);
		background: #fff;
	}
	.ws {
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 2px 4px 14px;
	}
	.mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 9px;
		color: #fff;
		background: var(--green);
	}
	.who {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.who b {
		font-size: 13px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.who small {
		font-size: 11px;
		color: var(--soft);
		white-space: nowrap;
	}
	.nav {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}
	.nav li {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 32px;
		padding: 0 10px;
		border-radius: 8px;
		color: #3f3f46;
		white-space: nowrap;
		transition:
			background-color 0.4s ease,
			color 0.4s ease;
	}
	.nav li svg {
		color: var(--soft);
	}
	.stage[data-view='builder'] .nav li[data-on~='builder'],
	.stage[data-view='sql'] .nav li[data-on~='sql'],
	.stage[data-view='copilot'] .nav li[data-on~='copilot'],
	.stage[data-view='dashboard'] .nav li[data-on~='dashboard'] {
		background: var(--tint);
		color: var(--ink);
		font-weight: 600;
	}
	.side-title {
		margin: 16px 10px 6px !important;
		font-size: 11px;
		font-weight: 600;
		color: var(--soft);
	}
	.folders li {
		height: 30px;
		padding-left: 14px;
		font-size: 12.5px;
	}
	.folders li i {
		width: 9px;
		height: 9px;
		border-radius: 3px;
		background: var(--c);
	}
	.me {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-top: auto;
		padding: 10px 4px 0;
		border-top: 1px solid var(--line);
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		font-size: 10.5px;
		font-weight: 700;
		color: #fff;
		background: linear-gradient(135deg, #f472b6, #8b5cf6);
	}

	/* The bar */
	.top {
		position: absolute;
		top: 30px;
		left: 200px;
		right: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 54px;
		padding: 0 16px 0 20px;
		border-bottom: 1px solid var(--line);
		background: #fff;
	}
	.top small {
		display: block;
		font-size: 11px;
		color: var(--soft);
	}
	.top b {
		font-size: 15.5px;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
	.top-end {
		display: grid;
		grid-auto-flow: column;
		align-items: center;
		justify-content: end;
		gap: 8px;
	}
	.top-end > * {
		grid-row: 1;
	}
	.top-end > [data-show='builder copilot']:first-child {
		grid-column: 1;
	}
	.top-end > [data-show='builder copilot']:nth-child(2),
	.top-end > [data-show='sql'],
	.top-end > [data-show='dashboard'] {
		grid-column: 2;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 30px;
		padding: 0 12px;
		border-radius: 8px;
		font-size: 12.5px;
		font-weight: 600;
		white-space: nowrap;
	}
	.btn.green {
		color: #fff;
		background: var(--green);
	}
	.btn.ghost {

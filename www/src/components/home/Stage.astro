---
/**
 * The window of the home page's story: eodia insights, drawn as the application draws it —
 * its sidebar, its bar, and five moments of the same afternoon on the demo shop: a question
 * built without SQL, the SQL editor joining PostgreSQL and MongoDB, the AI assistant asked
 * about the channels, the dashboard where it all ends up, and the curve prolonged by its
 * forecast.
 *
 * The `data-view` its parent writes (`builder`, `sql`, `assistant`, `dashboard`, `forecast`)
 * picks what shows; CSS does the rest — bars that grow, a curve that draws itself, cards that
 * rise, steps that tick. Without JavaScript, the question. Drawn at a fixed size, 1080 × 600,
 * and scaled to the width it is given.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
	/** The smallest scale: under it, the window is cut on the right rather than shrunk. */
	minScale?: number;
}

const { locale, minScale = 0.5 } = Astro.props;
const { t, lang } = i18n(locale);
const s = t.stage;

const money = (n: number, compact = false) =>
	new Intl.NumberFormat(lang, {
		style: 'currency',
		currency: 'EUR',
		...(compact ? { notation: 'compact', maximumFractionDigits: compact && n >= 1e6 ? 2 : 0 } : { maximumFractionDigits: 2, minimumFractionDigits: 2 }),
	}).format(n);
const number = (n: number, digits = 0) => new Intl.NumberFormat(lang, { maximumFractionDigits: digits, minimumFractionDigits: digits }).format(n);
const monthName = (i: number, style: 'short' | 'long' = 'short') =>
	new Intl.DateTimeFormat(lang, { month: style, year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(2025, i, 1)));

/** Revenue by channel: the question's bars. */
const CHANNELS = [612_400, 438_150, 231_900];
const CHANNEL_COLORS = ['#2da31e', '#14b8a6', '#a3d93a'];
const TOP = Math.max(...CHANNELS);
const channels = s.channels.map((label, i) => ({
	label,
	value: money(CHANNELS[i]!, true),
	height: Math.round((CHANNELS[i]! / TOP) * 100),
	color: CHANNEL_COLORS[i]!,
}));

/** The assistant's answer: the average basket by channel. */
const BASKETS = [82.1, 87.4, 76.8];
const baskets = s.channels.map((label, i) => ({ label, value: money(BASKETS[i]!), height: Math.round(((BASKETS[i]! - 60) / (90 - 60)) * 100), hot: i === 1 }));

/** The SQL editor's result: one line per region. */
const REGION_FACTS: Array<[number, number, number]> = [
	[92.4, 1284, 4.5],
	[88.1, 702, 4.6],
	[86.7, 498, 4.4],
	[91.2, 421, 4.7],
	[84.9, 402, 4.5],
	[83.5, 377, 4.3],
];
const regions = s.regions.map((name, i) => {
	const [basket, tickets, score] = REGION_FACTS[i]!;
	return { name, basket: money(basket), tickets: number(tickets), score: number(score, 1), bar: Math.round((tickets / 1284) * 100) };
});

/**
 * Monthly revenue: two years measured (January 2025 on), then six months forecast — a trend
 * and a season, prolonged as the application's Holt-Winters would.
 */
const N = 24;
const H = 6;
const truth = (i: number) => 420 + 26 * i + 120 * Math.sin((2 * Math.PI * (i - 4)) / 12);
const noise = (i: number) => (((i * 37) % 11) - 5) * 9;
const measured = Array.from({ length: N }, (_, i) => truth(i) + noise(i));
const ahead = Array.from({ length: H }, (_, k) => truth(N + k));
const spread = (k: number) => 30 + 22 * Math.sqrt(k + 1);
const curve = (w: number, h: number, count: number, lo: number, hi: number) => {
	const x = (i: number) => 8 + (i / (count - 1)) * (w - 16);
	const y = (v: number) => h - 6 - ((v - lo) / (hi - lo)) * (h - 16);
	const path = (pts: Array<[number, number]>) => pts.map(([i, v], j) => `${j ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
	return { x, y, path };
};
// The dashboard's card: the last twelve months.
const dash = curve(520, 170, 12, 600, 1250);
const last12 = measured.slice(N - 12).map((v, i) => [i, v] as [number, number]);
const dashLine = dash.path(last12);
const dashArea = `${dashLine} L${dash.x(11).toFixed(1)} 170 L${dash.x(0).toFixed(1)} 170 Z`;
// The forecast's chart: the two years and the six months.
const fc = curve(600, 300, N + H, 250, 1350);
const pastLine = fc.path(measured.map((v, i) => [i, v]));
const pastArea = `${pastLine} L${fc.x(N - 1).toFixed(1)} 300 L${fc.x(0).toFixed(1)} 300 Z`;
const nextLine = fc.path([[N - 1, measured[N - 1]!], ...ahead.map((v, k) => [N + k, v] as [number, number])]);
const band = `${fc.path([[N - 1, measured[N - 1]!], ...ahead.map((v, k) => [N + k, v + spread(k)] as [number, number])])} ${ahead
	.map((v, k) => [N + k, v - spread(k)] as [number, number])
	.reverse()
	.map(([i, v]) => `L${fc.x(i).toFixed(1)} ${fc.y(v).toFixed(1)}`)
	.join(' ')} L${fc.x(N - 1).toFixed(1)} ${fc.y(measured[N - 1]!).toFixed(1)} Z`;
const TIP = 2;
const tip = { x: fc.x(N + TIP), y: fc.y(ahead[TIP]!), month: monthName(N + TIP, 'long'), value: money(ahead[TIP]! * 1000, true), lo: money((ahead[TIP]! - spread(TIP)) * 1000, true), hi: money((ahead[TIP]! + spread(TIP)) * 1000, true) };
const fcTicks = [0, 6, 12, 18, 24].map((i) => ({ x: fc.x(i), label: monthName(i) }));
const zone = { x: fc.x(N - 0.5), w: fc.x(N + H - 1) - fc.x(N - 0.5) + 8 };

/** A sparkline: weekly orders, the last one down. */
const WEEKLY = [60, 64, 58, 66, 63, 70, 67, 72, 69, 74, 71, 52];
const spark = WEEKLY.map((v, i) => `${i ? 'L' : 'M'}${(i / (WEEKLY.length - 1)) * 96 + 2} ${32 - ((v - 48) / 28) * 28}`).join(' ');

/** The SQL, as the editor colours it. */
const kw = (w: string) => `<span class="k">${w}</span>`;
const fn = (w: string) => `<span class="f">${w}</span>`;
const id = (w: string) => `<span class="i">${w}</span>`;
const SQL = [
	`${kw('select')} c.region,`,
	`       ${fn('avg')}(o.montant_total) ${kw('as')} panier_moyen,`,
	`       ${fn('count')}(t.ticket_id)   ${kw('as')} tickets,`,
	`       ${fn('avg')}(t.satisfaction)  ${kw('as')} satisfaction`,
	`  ${kw('from')} ${id('boutique')}.public.commandes o`,
	`  ${kw('join')} ${id('boutique')}.public.clients c ${kw('on')} c.id = o.client_id`,
	`  ${kw('left join')} ${id('support')}.support.tickets t ${kw('on')} t.client_id = c.id`,
	` ${kw('group by')} c.region ${kw('order by')} tickets ${kw('desc')}`,
];

const ICON = {
	home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
	folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
	sql: '<path d="m8 9-3 3 3 3M16 9l3 3-3 3M13.5 6l-3 12"/>',
	sources: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
	structure: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>',
	history: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/>',
	admin: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/>',
	api: '<path d="M4 19.5V5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM8 7h7"/>',
	lock: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><rect x="10" y="12" width="5" height="4" rx="1"/><path d="M11 12v-1.2a1.5 1.5 0 0 1 3 0V12"/>',
	headset: '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>',
	bag: '<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
	check: '<path d="M20 6 9 17l-5-5"/>',
	chevron: '<path d="m6 9 6 6 6-6"/>',
	updown: '<path d="m7 15 5 5 5-5M7 9l5-5 5 5"/>',
	sparkle: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
	panel: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	play: '<path d="M7 4v16l13-8z"/>',
	calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
	filter: '<path d="M4 6h16M7 12h10M10 18h4"/>',
	share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/>',
	db: '<ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6"/>',
	send: '<path d="M12 19V5M5 12l7-7 7 7"/>',
	trend: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>',
	bars: '<path d="M5 20V10M12 20V4M19 20v-7"/>',
	table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M10 4v16"/>',
	waves: '<path d="M2 12c2.5-4 5-4 7.5 0s5 4 7.5 0 3.5-2.5 5-2"/>',
} as const;
const svg = (name: keyof typeof ICON, size = 15, width = 1.9) =>
	`<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round">${ICON[name]}</svg>`;

const nav = [
	{ key: 'home', icon: 'home', on: '' },
	{ key: 'assistant', icon: '', on: 'assistant' },
	{ key: 'folders', icon: 'folder', on: '' },
] as const;
const folders = [
	{ name: s.folderNames[0], icon: 'lock', color: '#71717a', on: '' },
	{ name: s.folderNames[1], icon: 'headset', color: '#8b5cf6', on: '' },
	{ name: s.folderNames[2], icon: 'bag', color: '#16a34a', on: 'builder dashboard forecast' },
] as const;
const tools = [
	{ key: 'sql', icon: 'sql', on: 'sql' },
	{ key: 'sources', icon: 'sources', on: '' },
	{ key: 'structure', icon: 'structure', on: '' },
	{ key: 'history', icon: 'history', on: '' },
] as const;
const VIEWS = ['builder', 'sql', 'assistant', 'dashboard', 'forecast'] as const;
---

<div class="frame" data-frame data-min={minScale}>
	<div class="stage" data-stage data-view="builder">
		<div class="chrome" aria-hidden="true">
			<div class="dots"><i></i><i></i><i></i></div>
			<span class="url">{s.url}</span>
		</div>

		<!-- The sidebar, as the application has it -->
		<aside class="side" aria-hidden="true">
			<div class="ws">
				<svg class="mark" width="30" height="30" viewBox="0 0 64 64" fill="none">
					<rect width="64" height="64" rx="16" fill="#104832"></rect>
					<path d="M32 15a17 17 0 1 0 17 17" stroke="#dcf3bd" stroke-width="9" stroke-linecap="round"></path>
					<rect x="27" y="27" width="10" height="10" rx="3" fill="#dcf3bd"></rect>
					<circle cx="46" cy="18" r="5" fill="#76cf98"></circle>
				</svg>
				<span class="who"><b>{s.product}</b><small>{s.sources}</small></span>
				<span class="ud" set:html={svg('updown', 13)} />
			</div>
			<ul class="nav">
				{
					nav.map((n) => (
						<li data-on={n.on || undefined}>
							{n.icon ? <Fragment set:html={svg(n.icon)} /> : <span class="orb-i" />}
							<span class="grow">{s.nav[n.key]}</span>
							{n.key === 'assistant' ? <em class="badge">{s.badge}</em> : null}
						</li>
					))
				}
				{
					folders.map((f) => (
						<li class="sub" data-on={f.on || undefined} style={`--c:${f.color}`}>
							<Fragment set:html={svg(f.icon, 14)} />
							<span class="grow">{f.name}</span>
						</li>
					))
				}
				{
					tools.map((n) => (
						<li data-on={n.on || undefined}>
							<Fragment set:html={svg(n.icon)} />
							<span class="grow">{s.nav[n.key]}</span>
						</li>
					))
				}
			</ul>
			<ul class="nav foot">
				<li>
					<Fragment set:html={svg('admin')} />
					<span class="grow">{s.nav.admin}</span>
					<Fragment set:html={svg('chevron', 12)} />
				</li>
				<li>
					<Fragment set:html={svg('api')} />
					<span class="grow">{s.nav.api}</span>
				</li>
			</ul>
			<div class="me">
				<span class="avatar">AM<i></i></span>
				<span class="who"><b>{s.user.name}</b><small>{s.user.role}</small></span>
				<span class="ud" set:html={svg('updown', 13)} />
			</div>
		</aside>

		<!-- The bar: where one is, and what is always at hand -->
		<header class="top" aria-hidden="true">
			<span class="tb-icon" set:html={svg('panel', 16)} />
			<span class="crumbs">
				{
					VIEWS.map((v) => (
						<span data-show={v}>
							{s.crumbs[v].map((c, i, all) => (
								<>
									{i > 0 ? <i>/</i> : null}
									<b class:list={[i === all.length - 1 && all.length > 1 && 'last']}>{c}</b>
								</>
							))}
						</span>
					))
				}
			</span>
			<span class="new"><Fragment set:html={svg('plus', 13, 2.4)} />{s.newItem}</span>
			<span class="search"><Fragment set:html={svg('search', 13)} />{s.search}<kbd>Ctrl</kbd><kbd>K</kbd></span>
			<span class="spark" set:html={svg('sparkle', 16)} />
		</header>

		<!-- 1. The question, without SQL -->
		<section class="pane builder" data-show="builder" aria-hidden="true">
			<div class="pane-head">
				<b>{s.builder.title}</b>
				<span class="btn green">{s.builder.save}</span>
			</div>
			<div class="builder-body">
				<div class="notebook">
					<div class="step">
						<p>{s.builder.data}</p>
						<span class="pill blue"><Fragment set:html={svg('table', 13, 2)} />{s.builder.table}</span>
					</div>
					<div class="step">
						<p>{s.builder.filter}</p>
						<span class="pill violet">{s.builder.filterValue}</span>
					</div>
					<div class="step">
						<p>{s.builder.summarize}</p>
						<div class="row">
							<span class="pill green">{s.builder.metric}</span>
							<span class="by">{s.builder.by}</span>
							<span class="pill green">{s.builder.group}</span>
						</div>
					</div>
					<span class="visualize">{s.builder.visualize}</span>
				</div>
				<div class="card chart">
					<p class="card-title">{s.builder.title}</p>
					<div class="bars">
						{
							channels.map((c, i) => (
								<div class="bar" style={`--h:${c.height}%;--i:${i};--c:${c.color}`}>
									<span class="val">{c.value}</span>
									<i />
									<span class="lab">{c.label}</span>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- 2. The SQL editor -->
		<section class="pane sql" data-show="sql" aria-hidden="true">
			<div class="pane-head">
				<b>{s.sql.title}</b>
				<span class="btn green"><Fragment set:html={svg('play', 11, 0)} />{s.sql.run}</span>
			</div>
			<div class="editor">
				<ol>
					{SQL.map((l) => <li set:html={l} />)}
				</ol>
				<span class="caret"></span>
			</div>
			<div class="card result">
				<div class="result-head">
					{s.sql.columns.map((c, i) => <span class:list={[i > 0 && 'num']}>{c}</span>)}
				</div>
				{
					regions.map((r, i) => (
						<div class="result-row" style={`--i:${i}`}>
							<span>{r.name}</span>
							<span class="num">{r.basket}</span>
							<span class="num tick">
								<i style={`--w:${r.bar}%`} />
								{r.tickets}
							</span>
							<span class="num">{r.score}</span>
						</div>
					))
				}
				<p class="foot">{s.sql.rows}</p>
			</div>
		</section>

		<!-- 3. The AI assistant: a conversation with the data -->
		<section class="pane assistant" data-show="assistant" aria-hidden="true">
			<div class="threads">
				<span class="btn green wide"><Fragment set:html={svg('plus', 13, 2.4)} />{s.assistant.newChat}</span>
				<span class="find"><Fragment set:html={svg('search', 12)} />{s.assistant.search}</span>
				<small>{s.assistant.today}</small>
				{s.assistant.history.map((h, i) => <span class:list={['thread', i === 0 && 'on']}>{h}</span>)}
			</div>
			<div class="talk">
				<div class="glow-a"></div>
				<p class="ask">{s.assistant.ask}</p>
				<div class="answer">
					<span class="orb"></span>
					<div class="answer-body">
						<ul class="chips">
							{
								s.assistant.steps.map((step, i) => (
									<li style={`--i:${i}`}>
										<Fragment set:html={svg('check', 11, 3)} />
										{step}
									</li>
								))
							}
						</ul>
						<p class="said" set:html={s.assistant.answer} />
						<div class="card mini">
							<div class="mini-head">
								<span>
									<b>{s.assistant.chartTitle}</b>
									<small>{s.assistant.chartSub}</small>
								</span>
								<span class="kinds">
									<i class="on" set:html={svg('bars', 12)} />
									<i set:html={svg('trend', 12)} />
									<i set:html={svg('table', 12)} />
								</span>
							</div>
							<div class="mini-bars">
								{
									baskets.map((b, i) => (
										<div class="mbar" style={`--h:${b.height}%;--i:${i}`} data-hot={b.hot ? '' : undefined}>
											<span class="val">{b.value}</span>
											<i />
											<span class="lab">{b.label}</span>
										</div>
									))
								}
							</div>
							<div class="mini-foot">
								<span><Fragment set:html={svg('db', 11)} />{s.assistant.rows}</span>
								<span class="save">{s.assistant.save} ›</span>
							</div>
						</div>
					</div>
				</div>
				<div class="composer">
					<span class="ph">{s.assistant.placeholder}</span>
					<span class="row">
						<span class="src"><Fragment set:html={svg('db', 11)} />{s.assistant.sources}</span>
						<span class="hint">{s.assistant.hint}</span>
						<span class="go" set:html={svg('send', 13, 2.2)} />
					</span>
				</div>
			</div>
		</section>

		<!-- 4. The dashboard -->
		<section class="pane dash" data-show="dashboard" aria-hidden="true">
			<div class="dash-head">
				<span>
					<b>{s.dashboard.title}</b>
					<small>{s.dashboard.description}</small>
				</span>
				<span class="btn ghost"><Fragment set:html={svg('share', 12)} />{s.dashboard.share}</span>
				<span class="btn ghost">{s.dashboard.edit}</span>
			</div>
			<div class="filters">
				{
					s.dashboard.filters.map((f, i) => (
						<span class:list={['filter', f.value && 'set']}>
							<Fragment set:html={svg(i === 0 ? 'calendar' : 'filter', 12)} />
							<span class="fl">{f.label}</span>
							{f.value ? <b>{f.value}</b> : null}
							<Fragment set:html={svg('chevron', 11, 2.4)} />
						</span>
					))
				}
			</div>
			<div class="tabs">{s.dashboard.tabs.map((tab, i) => <span class:list={[i === 0 && 'on']}>{tab}</span>)}</div>
			<div class="kpis">
				{
					s.dashboard.kpis.map((k, i) => (
						<div class="card kpi" style={`--i:${i}`}>
							<small>{k.label}</small>
							<span class="kv">
								<b>{k.value}</b>
								{i === 3 ? <svg class="sparkline" viewBox="0 0 100 36" preserveAspectRatio="none"><path d={spark} /></svg> : null}
							</span>
							{k.delta ? <em>{k.delta}</em> : null}
						</div>
					))
				}
			</div>
			<div class="card trend" style="--i:4">
				<p class="card-title">{s.dashboard.trend}</p>
				<svg viewBox="0 0 520 172" preserveAspectRatio="none">
					<defs>
						<linearGradient id="st-area" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#2563eb" stop-opacity="0.22"></stop>
							<stop offset="1" stop-color="#2563eb" stop-opacity="0"></stop>
						</linearGradient>
					</defs>
					{[40, 85, 130].map((y) => <line x1="8" x2="512" y1={y} y2={y} class="grid" />)}

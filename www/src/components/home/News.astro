---
/**
 * What is new, in six cards — each with a small drawing of the thing itself, most of them
 * moving: a bar race overtaking, bubbles and a treemap, a calendar of days, key figures with
 * their sparkline, the interface in three languages, a chart refreshed in place. Pure HTML,
 * SVG and CSS; every card links to its page of the documentation.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href } = i18n(locale);
const n = t.news;
const items = Object.entries(n.items).map(([key, item]) => ({ key, ...item, href: href(item.href) }));

// A year of days, Monday to Sunday, in shades.
const DAYS = Array.from({ length: 7 * 18 }, (_, i) => {
	const w = Math.floor(i / 7);
	const d = i % 7;
	const v = 0.25 + 0.35 * Math.sin(w / 2.6) + (d >= 5 ? -0.2 : 0.12) + ((i * 37) % 11) / 30;
	return Math.max(0.08, Math.min(1, v));
});
const RACE = [
	{ label: 'Lyon', c: '#2a78d6' },
	{ label: 'Paris', c: '#2da31d' },
	{ label: 'Nantes', c: '#eda100' },
	{ label: 'Lille', c: '#e87ba4' },
];
const LIVE = [42, 58, 50, 72, 64, 80, 70];
---

<section class="tm-section news" data-news>
	<div class="tm-head">
		<p class="tm-kicker tm-rise">{n.kicker}</p>
		<h2 class="tm-display tm-rise">
			<span>{n.title}</span>
			<span class="tm-grad">{n.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{n.lede}</p>
	</div>

	<div class="grid">
		{
			items.map((item, i) => (
				<a href={item.href} class:list={['card', 'tm-rise', item.key]} style={`transition-delay:${(i % 3) * 0.07}s`}>
					<div class="art" aria-hidden="true">
						{item.key === 'races' && (
							<div class="race">
								{RACE.map((r, j) => (
									<p class={`lane l${j}`}>
										<span class="who">{r.label}</span>
										<span class="track">
											<i style={`background:${r.c}`} />
										</span>
									</p>
								))}
								<span class="period">
									<b>{n.periods[0]}</b>
									<b>{n.periods[1]}</b>
									<b>{n.periods[2]}</b>
								</span>
							</div>
						)}
						{item.key === 'bubbles' && (
							<div class="bub">
								<svg viewBox="0 0 120 110" width="132" height="121">
									<circle cx="48" cy="58" r="34" fill="rgba(91,60,245,.18)" stroke="rgba(91,60,245,.5)" />
									<text x="48" y="63" fill="#5b3cf5" font-size="15">48 %</text>
									<circle cx="94" cy="72" r="23" fill="rgba(63,161,242,.18)" stroke="rgba(63,161,242,.5)" />
									<text x="94" y="76" fill="#2a78d6" font-size="11">32 %</text>
									<circle cx="86" cy="26" r="18" fill="rgba(245,178,107,.22)" stroke="rgba(245,178,107,.6)" />
									<text x="86" y="30" fill="#c97a1c" font-size="9.5">20 %</text>
								</svg>
								<span class="tree">
									<i class="t1" />
									<i class="t2" />
									<i class="t3" />
									<i class="t4" />
									<i class="t5" />
								</span>
							</div>
						)}
						{item.key === 'calendar' && (
							<div class="cal">
								{DAYS.map((v) => (
									<i style={`opacity:${v.toFixed(2)}`} />
								))}
							</div>
						)}
						{item.key === 'sparks' && (
							<div class="kpis">
								{n.kpis.map((k, j) => (
									<span class="kpi">
										<span class="k-label">{k.label}</span>
										<span class="k-row">
											<b>{k.value}</b>
											<svg viewBox="0 0 64 22" class:list={['spark', { down: j === 1 }]}>
												<polyline points={j === 1 ? '0,4 10,6 20,5 30,10 40,9 50,14 64,17' : '0,18 10,15 20,16 30,10 40,12 50,6 64,3'} />
											</svg>
										</span>
										<span class:list={['k-delta', { down: j === 1 }]}>{k.delta}</span>
									</span>
								))}
							</div>
						)}
						{item.key === 'languages' && (
							<div class="langs">
								<span class="flags">
									<b>FR</b>
									<b>EN</b>
									<b>ES</b>
								</span>
								<span class="say">
									{n.say.map((s) => (
										<em>{s}</em>
									))}
								</span>
							</div>
						)}
						{item.key === 'live' && (
							<div class="refresh">
								<span class="clock">
									<svg viewBox="0 0 36 36" width="30" height="30">
										<circle cx="18" cy="18" r="14" class="c-bg" />
										<circle cx="18" cy="18" r="14" class="c-fg" pathLength="100" />
									</svg>
									{n.every}
								</span>
								<span class="bars">
									{LIVE.map((h, j) => (
										<i style={`--h:${h}%;--j:${j}`} />
									))}
								</span>
							</div>
						)}
					</div>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					<span class="go">{n.more} ›</span>
				</a>
			))
		}
	</div>
</section>

<style>
	.news {
		background: radial-gradient(50% 35% at 50% 30%, rgba(45, 163, 30, 0.06), transparent 70%), #fff;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		max-width: 1180px;
		margin: 72px auto 0;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 18px 22px;
		border-radius: 26px;
		background: var(--tm-mist);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.35s ease,
			opacity 0.9s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 24px 50px -28px rgba(16, 40, 16, 0.35);
	}
	.card h3 {
		margin: 10px 4px 0;
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.card > p {
		margin: 0 4px;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--tm-slate);
	}
	.go {
		margin: auto 4px 0;
		padding-top: 8px;
		font-size: 15px;
		font-weight: 500;
		color: #1b8c14;
	}
	.art {
		display: grid;
		place-items: center;
		height: 190px;
		border-radius: 18px;
		background: #fff;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04);
		overflow: hidden;
		font-family: var(--bd-font-sans);
	}
	.art p {
		margin: 0;
	}
	/* A bar race: four lanes that overtake, the period written large. */
	.race {
		position: relative;
		width: 250px;
		height: 150px;
		font-size: 11.5px;
	}
	.lane {
		position: absolute;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 8px;
		height: 26px;
		animation: n-swap 9s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}
	.who {
		width: 42px;
		color: #52525b;
		text-align: right;
	}
	.track {
		flex: 1;
	}
	.track i {
		display: block;
		height: 18px;
		border-radius: 0 5px 5px 0;
		animation: n-grow 9s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}
	.l0 { --a: 0px; --b: 34px; --c: 68px; --wa: 92%; --wb: 78%; --wc: 64%; }
	.l1 { --a: 34px; --b: 0px; --c: 0px; --wa: 80%; --wb: 96%; --wc: 100%; }
	.l2 { --a: 68px; --b: 102px; --c: 34px; --wa: 60%; --wb: 52%; --wc: 82%; }
	.l3 { --a: 102px; --b: 68px; --c: 102px; --wa: 44%; --wb: 58%; --wc: 50%; }
	@keyframes n-swap {
		0%, 25% { transform: translateY(var(--a)); }
		38%, 60% { transform: translateY(var(--b)); }
		73%, 92% { transform: translateY(var(--c)); }
		100% { transform: translateY(var(--a)); }
	}
	@keyframes n-grow {
		0%, 25% { width: var(--wa); }
		38%, 60% { width: var(--wb); }
		73%, 92% { width: var(--wc); }
		100% { width: var(--wa); }
	}
	.period {
		position: absolute;
		right: 0;
		bottom: 0;
		display: grid;
		font-size: 22px;
		font-weight: 700;
		color: rgba(0, 0, 0, 0.16);
	}
	.period b {
		grid-area: 1 / 1;
		text-align: right;
		opacity: 0;
		animation: n-period 9s infinite;
	}
	.period b:nth-child(2) { animation-delay: 3s; }
	.period b:nth-child(3) { animation-delay: 6s; }
	@keyframes n-period {
		0%, 30% { opacity: 1; }
		36%, 100% { opacity: 0; }
	}
	/* Bubbles and a treemap. */
	.bub {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.bub text {
		font-weight: 700;
		text-anchor: middle;
	}
	.bub circle {
		animation: n-breathe 4s ease-in-out infinite;
		transform-origin: center;
		transform-box: fill-box;
	}
	.bub circle:nth-of-type(2) { animation-delay: 0.6s; }
	.bub circle:nth-of-type(3) { animation-delay: 1.2s; }
	@keyframes n-breathe {
		50% { transform: scale(1.05); }
	}
	.tree {
		display: grid;
		grid-template: 1fr 1fr / 1.4fr 1fr 0.7fr;
		gap: 3px;
		width: 96px;
		height: 96px;
	}
	.tree i { border-radius: 4px; }
	.t1 { grid-row: 1 / 3; background: #5b3cf5; }
	.t2 { background: #8b74f8; }
	.t3 { background: #b8a9fb; }
	.t4 { background: #3fa1f2; }
	.t5 { background: #9ccdf7; }
	/* A calendar of days. */
	.cal {
		display: grid;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 11px);
		gap: 3px;
	}
	.cal i {
		width: 11px;
		border-radius: 3px;
		background: #2da31d;
	}
	/* Key figures and their sparklines. */
	.kpis {
		display: flex;
		gap: 10px;
	}
	.kpi {
		display: flex;
		flex-direction: column;
		gap: 2px;
		width: 140px;
		padding: 10px 12px;
		border: 1px solid #ececf3;
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 8px 20px -14px rgba(0, 0, 0, 0.25);
	}
	.k-label {
		font-size: 10.5px;
		font-weight: 600;
		color: #3f3f46;
	}
	.k-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 6px;
	}
	.k-row b {
		white-space: nowrap;
		font-size: 18px;
		letter-spacing: -0.02em;
	}
	.spark {
		width: 46px;
		height: 18px;
		overflow: visible;
	}
	.spark polyline {
		fill: none;
		stroke: #16a34a;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 90;
		animation: n-draw 3.5s ease-out infinite;
	}
	.spark.down polyline { stroke: #dc2626; }
	@keyframes n-draw {
		0% { stroke-dashoffset: 90; }
		45%, 100% { stroke-dashoffset: 0; }
	}
	.k-delta {
		font-size: 10px;
		font-weight: 600;
		color: #16a34a;
	}
	.k-delta.down { color: #dc2626; }
	/* Three languages. */
	.langs {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}
	.flags {
		display: flex;
		gap: 6px;
	}
	.flags b {
		padding: 4px 10px;
		border-radius: 8px;
		font-size: 12px;
		color: #52525b;
		background: #f4f4f5;
		animation: n-flag 7.5s infinite;
	}
	.flags b:nth-child(2) { animation-delay: 2.5s; }
	.flags b:nth-child(3) { animation-delay: 5s; }
	@keyframes n-flag {
		0%, 30% { color: #fff; background: #2da31d; }
		34%, 100% { color: #52525b; background: #f4f4f5; }
	}
	.say {
		display: grid;
		padding: 10px 18px;
		border: 1px solid #e4e4e7;
		border-radius: 12px;
		font-size: 15px;
		font-weight: 600;
		background: #fff;
	}
	.say em {
		grid-area: 1 / 1;
		font-style: normal;
		text-align: center;
		opacity: 0;
		animation: n-period 7.5s infinite;
	}
	.say em:nth-child(2) { animation-delay: 2.5s; }
	.say em:nth-child(3) { animation-delay: 5s; }
	/* A chart refreshed in place: its bars slide to their new values. */
	.refresh {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}
	.clock {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		color: #52525b;
	}
	.clock svg { transform: rotate(-90deg); }
	.c-bg { fill: none; stroke: #ececef; stroke-width: 4; }
	.c-fg {
		fill: none;
		stroke: #2da31d;
		stroke-width: 4;
		stroke-dasharray: 100;
		animation: n-tick 3s linear infinite;
	}
	@keyframes n-tick {
		from { stroke-dashoffset: 100; }
		to { stroke-dashoffset: 0; }
	}
	.refresh .bars {
		display: flex;
		align-items: flex-end;
		gap: 7px;
		height: 90px;
	}
	.refresh .bars i {
		width: 18px;
		height: var(--h);
		border-radius: 5px 5px 0 0;
		background: linear-gradient(#2a78d6, #6da7ec);
		animation: n-live 6s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
		animation-delay: calc(var(--j) * 40ms);
	}
	@keyframes n-live {
		0%, 45% { height: var(--h); }
		50%, 95% { height: calc(100% - var(--h) + 18%); }
		100% { height: var(--h); }
	}
	@media (max-width: 980px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.art * {
			animation: none !important;
		}
		.period b:first-child,
		.say em:first-child {
			opacity: 1;
		}
	}
</style>

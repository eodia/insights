---
/**
 * What is new, in six cards — each with a small drawing of the thing itself: the
 * associative filter list, Shift + click on a chart, the palettes, the radar with a value
 * that stands out, a chart drawn in a conversation with Claude, filing by drag and drop.
 * Pure HTML and SVG; every card links to its page of the documentation.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href } = i18n(locale);
const n = t.news;
const items = Object.entries(n.items).map(([key, item]) => ({ key, ...item, href: href(item.href) }));

const ROWS = [
	{ state: 'on', share: 1, count: '3 100' },
	{ state: 'on', share: 0.14, count: '410' },
	{ state: 'maybe', share: 0.12, count: '380' },
	{ state: 'off', share: 0.5, count: '1 633' },
	{ state: 'off', share: 0.46, count: '1 520' },
];
const BARS = [52, 78, 44, 92, 61, 70];
const PICKED = new Set([1, 3]);
const PALETTES = [
	['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7', '#e34948'],
	['#2563eb', '#f43f5e', '#8b5cf6', '#f97316', '#10b981', '#f59e0b', '#6366f1', '#ef4444'],
	['#0369a1', '#059669', '#4f46e5', '#14b8a6', '#818cf8', '#7c3aed', '#38bdf8', '#1d4ed8'],
	['#b45309', '#65a30d', '#a16207', '#a855f7', '#be123c', '#ca8a04', '#e11d48', '#d97706'],
	['#5b8def', '#e07a5f', '#b07cc6', '#7a9a3c', '#8c7ae6', '#c96f8a', '#d4a017', '#3d9970'],
];
const radar = (values: number[], r = 46, cx = 60, cy = 56) =>
	values
		.map((v, i) => {
			const a = (Math.PI * 2 * i) / values.length - Math.PI / 2;
			return `${(cx + Math.cos(a) * r * v).toFixed(1)},${(cy + Math.sin(a) * r * v).toFixed(1)}`;
		})
		.join(' ');
const ring = (k: number) => radar([k, k, k, k, k, k]);
const MINI = [34, 48, 41, 66, 38, 29];
---

<section class="tm-section news" data-news>
	<div class="tm-head">
		<p class="tm-kicker tm-rise">{n.kicker}</p>
		<h2 class="tm-display tm-rise">
			<span>{n.title}</span>
			<span class="tm-grad">{n.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{n.lede}</p>
	</div>

	<div class="grid">
		{
			items.map((item, i) => (
				<a href={item.href} class:list={['card', 'tm-rise', item.key]} style={`transition-delay:${(i % 3) * 0.07}s`}>
					<div class="art" aria-hidden="true">
						{item.key === 'associative' && (
							<div class="list">
								<p class="l-head">
									<b>{n.chosen}</b>
									<span>74 %</span>
								</p>
								<span class="l-bar">
									<i style="width:74%" />
								</span>
								{ROWS.map((r, j) => (
									<p class:list={['row', r.state]}>
										<i class="fill" style={`width:${r.share * 100}%`} />
										<span class="check">{r.state === 'on' ? '✓' : ''}</span>
										<span class="name">{n.values[j]}</span>
										<span class="count">{r.count}</span>
									</p>
								))}
							</div>
						)}
						{item.key === 'click' && (
							<div class="bars">
								{BARS.map((h, j) => (
									<span class:list={['bar', { picked: PICKED.has(j) }]} style={`height:${h}%`} />
								))}
								<span class="cursor">
									<kbd>⇧</kbd>
									<svg width="22" height="22" viewBox="0 0 24 24"><path d="M4 2l15 9-6.5 1.5L16 20l-3 1.5-3.4-7.5L4 18z" fill="#1d1d1f" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" /></svg>
								</span>
							</div>
						)}
						{item.key === 'palettes' && (
							<div class="pals">
								{PALETTES.map((p) => (
									<span class="strip">
										{p.map((c) => (
											<i style={`background:${c}`} />
										))}
									</span>
								))}
								<span class="safe">✓ {n.safe}</span>
							</div>
						)}
						{item.key === 'radar' && (
							<svg class="radar" viewBox="0 0 220 112" width="220" height="112">
								{[1, 0.66, 0.33].map((k) => (
									<polygon points={ring(k)} class="web" />
								))}
								<polygon points={radar([0.9, 0.62, 0.95, 0.7, 0.5, 0.82])} class="a" />
								<polygon points={radar([0.6, 0.92, 0.58, 0.85, 0.83, 0.48])} class="b" />
								{MINI.map((h, j) => (
									<rect x={136 + j * 13} y={100 - h * 1.3} width="9" height={h * 1.3} rx="2" class:list={['mini', { hi: j === 3 }]} />
								))}
								<line x1="132" x2="212" y1={100 - 42 * 1.3} y2={100 - 42 * 1.3} class="avg" />
							</svg>
						)}
						{item.key === 'mcp' && (
							<div class="chat">
								<p class="ask">{n.ask}</p>
								<div class="answer">
									<span class="tool">show_chart</span>
									<span class="mini-bars">
										{[40, 55, 48, 70, 63, 82, 77].map((h) => (
											<i style={`height:${h}%`} />
										))}
									</span>
								</div>
							</div>
						)}
						{item.key === 'organize' && (
							<div class="tree">
								<p class="node">
									<span>📁</span>
									{n.folders[0]}
								</p>
								<p class="node sub over">
									<span>📈</span>
									{n.folders[1]}
								</p>
								<p class="node">
									<span>🎧</span>
									{n.folders[2]}
								</p>
								<p class="ghost">
									<span>▦</span>
									{n.drag}
								</p>
							</div>
						)}
					</div>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					<span class="go">{n.more} ›</span>
				</a>
			))
		}
	</div>
</section>

<style>
	.news {
		background: radial-gradient(50% 35% at 50% 30%, rgba(45, 163, 30, 0.06), transparent 70%), #fff;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		max-width: 1180px;
		margin: 72px auto 0;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 18px 22px;
		border-radius: 26px;
		background: var(--tm-mist);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.35s ease,
			opacity 0.9s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 24px 50px -28px rgba(16, 40, 16, 0.35);
	}
	.card h3 {
		margin: 10px 4px 0;
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.card > p {
		margin: 0 4px;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--tm-slate);
	}
	.go {
		margin: auto 4px 0;
		padding-top: 8px;
		font-size: 15px;
		font-weight: 500;
		color: #1b8c14;
	}
	.art {
		display: grid;
		place-items: center;
		height: 190px;
		border-radius: 18px;
		background: #fff;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04);
		overflow: hidden;
		font-family: var(--bd-font-sans);
	}
	.art p {
		margin: 0;
	}

	/* The associative list */
	.list {
		width: 240px;
		font-size: 11.5px;
	}
	.l-head {
		display: flex;
		justify-content: space-between;
		margin-bottom: 4px !important;
	}
	.l-head span {
		font-weight: 700;
		color: #059669;
	}
	.l-bar {
		display: block;
		height: 4px;
		margin-bottom: 8px;
		border-radius: 4px;
		background: #eee;
	}
	.l-bar i {
		display: block;
		height: 100%;
		border-radius: 4px;
		background: #10b981;
	}
	.row {
		position: relative;
		display: flex;
		align-items: center;
		gap: 6px;
		height: 23px;
		padding: 0 8px;
		overflow: hidden;
		border-bottom: 1px solid #ececef;
	}
	.row .fill {
		position: absolute;
		inset: 0 auto 0 0;
		background: rgba(45, 163, 30, 0.08);
	}
	.row > span {
		position: relative;
	}
	.check {
		width: 10px;
	}
	.name {
		flex: 1;
	}
	.count {
		font-variant-numeric: tabular-nums;
		color: #8a8a8f;
	}
	.row.on {
		color: #fff;
		background: #10b981;
	}
	.row.on .fill {
		background: rgba(255, 255, 255, 0.15);
	}
	.row.on .count {
		color: rgba(255, 255, 255, 0.85);
	}
	.row.off {
		color: #9a9aa0;
		background: #f1f1f3;
	}
	.row.off .name {
		text-decoration: line-through;
		text-decoration-color: rgba(0, 0, 0, 0.2);
	}
	.row.off .fill {
		background: rgba(0, 0, 0, 0.04);
	}

	/* Shift + click */
	.bars {
		position: relative;
		display: flex;
		align-items: flex-end;
		gap: 10px;
		width: 230px;
		height: 130px;
		border-bottom: 1px solid #e3e3e8;
	}
	.bar {
		flex: 1;
		border-radius: 5px 5px 0 0;
		background: rgba(42, 120, 214, 0.25);
	}
	.bar.picked {
		background: #2a78d6;
	}
	.cursor {
		position: absolute;
		left: 128px;
		top: 6px;
		display: flex;
		align-items: center;
		gap: 4px;
	}
	kbd {
		padding: 2px 6px;
		border-radius: 6px;
		font-size: 12px;
		font-family: inherit;
		background: #fff;
		box-shadow: 0 0 0 1px #d4d4d8, 0 2px 0 #d4d4d8;
	}

	/* Palettes */
	.pals {
		display: grid;
		gap: 8px;
		width: 230px;
	}
	.strip {
		display: flex;
		height: 13px;
		overflow: hidden;
		border-radius: 4px;
	}
	.strip i {
		flex: 1;
	}
	.safe {
		margin-top: 4px;
		font-size: 12px;
		font-weight: 600;
		color: #059669;
	}

	/* Radar and the highlighted bar */
	.web {
		fill: none;
		stroke: #e3e3e8;
	}
	.radar .a {
		fill: rgba(42, 120, 214, 0.15);
		stroke: #2a78d6;
		stroke-width: 2;
	}
	.radar .b {
		fill: rgba(235, 104, 52, 0.12);
		stroke: #eb6834;
		stroke-width: 2;
	}
	.mini {
		fill: rgba(42, 120, 214, 0.28);
	}
	.mini.hi {
		fill: #2a78d6;
	}
	.avg {
		stroke: #6e6e73;
		stroke-dasharray: 3 3;
	}

	/* Chart in a conversation */
	.chat {
		display: grid;
		gap: 8px;
		width: 240px;
		font-size: 12px;
	}
	.ask {
		justify-self: end;
		max-width: 200px;
		padding: 7px 11px !important;
		border-radius: 14px 14px 4px 14px;
		color: #fff;
		background: #1d1d1f;
	}
	.answer {
		display: grid;
		gap: 8px;
		padding: 10px;
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 0 0 1px #e3e3e8, 0 10px 24px -14px rgba(0, 0, 0, 0.3);
	}
	.tool {
		justify-self: start;
		padding: 2px 8px;
		border-radius: 999px;
		font-family: var(--bd-font-mono, ui-monospace, monospace);
		font-size: 11px;
		color: #1b8c14;
		background: #eaf6e6;
	}
	.mini-bars {
		display: flex;
		align-items: flex-end;
		gap: 5px;
		height: 54px;
	}
	.mini-bars i {
		flex: 1;
		border-radius: 3px 3px 0 0;
		background: linear-gradient(180deg, #2a78d6, #5aa0ff);
	}

	/* Drag and drop */
	.tree {
		position: relative;
		display: grid;
		gap: 4px;
		width: 220px;
		font-size: 13px;
	}
	.node {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px !important;
		border-radius: 9px;
	}
	.node.sub {
		margin-left: 20px;
	}
	.node.over {
		background: rgba(45, 163, 30, 0.1);
		box-shadow: inset 0 0 0 2px rgba(45, 163, 30, 0.5);
	}
	.ghost {
		position: absolute;
		right: -6px;
		top: 22px;
		display: flex;
		gap: 6px;
		padding: 6px 10px !important;
		border-radius: 9px;
		font-size: 12px;
		background: #fff;
		box-shadow: 0 12px 26px -10px rgba(0, 0, 0, 0.35);
		transform: rotate(-4deg);
	}

	@media (max-width: 980px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>

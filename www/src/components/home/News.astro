---
/**
 * What is new, in six cards — each with a small drawing of the thing itself, most of them
 * moving: a home page of one's own, a change explained, a chart drilled into, flows from step
 * to step, a copilot that listens, a mention and a version kept. Pure HTML, SVG and CSS; every
 * card links to its page of the documentation.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href } = i18n(locale);
const n = t.news;
const items = Object.entries(n.items).map(([key, item]) => ({ key, ...item, href: href(item.href) }));

// What moved a figure: each part's share of the change, as on the app's « Pourquoi ça bouge ? ».
const PARTS = [52, 41, -9];
const widest = Math.max(...PARTS.map(Math.abs));

// Orders from a channel to their status: the drawing of a Sankey.
const LEFT = [50, 30, 20];
const RIGHT = [70, 18, 12];
const FLOWS = [
	[36, 9, 5],
	[22, 5, 3],
	[12, 4, 4],
];
const COLORS = ['#2a78d6', '#e8743b', '#19a979'];
const GAP = 4;
const tops = (values: readonly number[]) => values.map((_, i) => values.slice(0, i).reduce((s, v) => s + v + GAP, 0));
const leftTop = tops(LEFT);
const rightTop = tops(RIGHT);
const rightUsed = RIGHT.map(() => 0);
const bands = FLOWS.flatMap((row, i) => {
	let used = 0;
	return row.map((v, j) => {
		const a = (leftTop[i] as number) + used;
		const b = (rightTop[j] as number) + (rightUsed[j] as number);
		used += v;
		rightUsed[j] = (rightUsed[j] as number) + v;
		return { d: `M10 ${a}C120 ${a} 120 ${b} 230 ${b}L230 ${b + v}C120 ${b + v} 120 ${a + v} 10 ${a + v}Z`, color: COLORS[i] as string, k: i * 3 + j };
	});
});
---

<section class="tm-section news" data-news>
	<div class="tm-head">
		<p class="tm-kicker tm-rise">{n.kicker}</p>
		<h2 class="tm-display tm-rise">
			<span>{n.title}</span>
			<span class="tm-grad">{n.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{n.lede}</p>
	</div>

	<div class="grid">
		{
			items.map((item, i) => (
				<a href={item.href} class:list={['card', 'tm-rise', `k-${item.key}`, { lead: i === 0 }]} style={`transition-delay:${(i % 3) * 0.07}s`}>
					<div class="art" aria-hidden="true">
						{item.key === 'home' && (
							<div class="hm">
								<p class="hello">{n.art.hello}</p>
								<span class="pins">
									{n.art.kpis.map((k, j) => (
										<span class="pin" style={`--j:${j}`}>
											<em>{k.label}</em>
											<b>{k.value}</b>
											<i class:list={[{ down: k.delta.startsWith('−') }]}>{k.delta}</i>
										</span>
									))}
								</span>
								<span class="favs">
									{n.art.favs.map((f) => (
										<span class="fav">
											<span class="bars">
												<i style="--h:45%" />
												<i style="--h:60%" />
												<i style="--h:52%" />
												<i style="--h:75%" />
												<i style="--h:92%" />
											</span>
											<b>★ {f}</b>
										</span>
									))}
								</span>
							</div>
						)}
						{item.key === 'explain' && (
							<div class="ex">
								<p class="ex-head">
									<b>{n.art.explainHead}</b>
									<span>{n.art.explainDelta}</span>
								</p>
								{PARTS.map((v, j) => (
									<p class="part" style={`--j:${j}`}>
										<span class="who">{n.art.parts[j]}</span>
										<span class="track">
											<i class:list={[{ neg: v < 0 }]} style={`--w:${(Math.abs(v) / widest) * 100}%`} />
										</span>
										<span class:list={['by', { neg: v < 0 }]}>{v > 0 ? '+' : '−'}{Math.abs(v)} k€</span>
									</p>
								))}
								<p class="why">✦ {n.art.because}</p>
							</div>
						)}
						{item.key === 'drill' && (
							<div class="dr">
								<span class="crumbs">
									{n.art.crumbs.map((c, j) => (
										<b style={`--j:${j}`}>
											{j > 0 && <em>›</em>}
											{c}
										</b>
									))}
								</span>
								<span class="cols">
									{[40, 55, 48, 70, 62, 84, 58, 66, 74, 50, 61, 79].map((h, j) => (
										<i class:list={[{ hot: j === 2 }]} style={`--h:${h}%;--j:${j}`} />
									))}
								</span>
								<span class="cursor">👆</span>
							</div>
						)}
						{item.key === 'flows' && (
							<div class="fl">
								<svg viewBox="0 0 240 116" width="180" height="87">
									{bands.map((b) => (
										<path d={b.d} fill={b.color} class="band" style={`--k:${b.k}`} />
									))}
									{LEFT.map((v, i) => (
										<rect x="2" y={leftTop[i]} width="8" height={v} rx="2" fill={COLORS[i]} />
									))}
									{RIGHT.map((v, j) => (
										<rect x="230" y={rightTop[j]} width="8" height={v} rx="2" fill="#a1a1aa" />
									))}
									{n.art.channels.map((c, i) => (
										<text x="-4" y={(leftTop[i] as number) + (LEFT[i] as number) / 2} text-anchor="end" dominant-baseline="middle" class="name">
											{c}
										</text>
									))}
									{n.art.statuses.map((c, j) => (
										<text x="244" y={(rightTop[j] as number) + (RIGHT[j] as number) / 2} dominant-baseline="middle" class="name">
											{c}
										</text>
									))}
								</svg>
							</div>
						)}
						{item.key === 'voice' && (
							<div class="vo">
								<span class="mic">
									<i />
									<i />
									<b>
										<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="9" y="2" width="6" height="12" rx="3" />
											<path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4" />
										</svg>
									</b>
								</span>
								<p class="heard">« {n.art.heard} »</p>
								<span class="chips">
									{n.art.chips.map((c, j) => (
										<b style={`--j:${j}`}>{c}</b>
									))}
								</span>
							</div>
						)}
						{item.key === 'together' && (
							<div class="tg">
								<p class="note">
									<b class="who">MJ</b>
									<span set:html={n.art.mention} />
								</p>
								<p class="notif">
									<span class="bell">🔔</span>
									{n.art.notif}
								</p>
								<p class="ver">
									<span class="clock">↺</span>
									<span>{n.art.version}</span>
									<b>{n.art.restore}</b>
								</p>
							</div>
						)}
					</div>
					{i === 0 && <span class="badge">{n.badge}</span>}
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					<span class="go">{n.more} ›</span>
				</a>
			))
		}
	</div>
</section>

<style>
	.news {
		background: radial-gradient(50% 35% at 50% 30%, rgba(45, 163, 30, 0.06), transparent 70%), #fff;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		max-width: 1180px;
		margin: 72px auto 0;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 18px 22px;
		border-radius: 26px;
		background: var(--tm-mist);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.35s ease,
			opacity 0.9s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 24px 50px -28px rgba(16, 40, 16, 0.35);
	}
	/* The headline of the release: a little light of its own. */
	.card.lead {
		background: linear-gradient(160deg, rgba(45, 163, 30, 0.12), var(--tm-mist) 55%);
		box-shadow: inset 0 0 0 1px rgba(45, 163, 30, 0.25);
	}
	.badge {
		position: absolute;
		top: 28px;
		right: 28px;
		padding: 3px 10px;
		border-radius: 999px;
		background: #2da31d;
		color: #fff;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.card h3 {
		margin: 10px 4px 0;
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.card > p {
		margin: 0 4px;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--tm-slate);
	}
	.go {
		margin: auto 4px 0;
		padding-top: 8px;
		font-size: 15px;
		font-weight: 500;
		color: #1b8c14;
	}
	.art {
		position: relative;
		display: grid;
		place-items: center;
		height: 190px;
		border-radius: 18px;
		background: #fff;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04);
		overflow: hidden;
		font-family: var(--bd-font-sans);
	}
	.art p {
		margin: 0;
	}

	/* A home page of one's own: key figures pinned one after the other, favourites beneath. */
	.hm {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 262px;
		/* Beneath the « Nouveau » badge, not under it. */
		margin-top: 14px;
	}
	.hello {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #18181b;
	}
	.pins {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 6px;
	}
	.pin {
		display: flex;
		flex-direction: column;
		gap: 1px;
		padding: 6px 8px;
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 6px 16px -10px rgba(16, 40, 16, 0.4), inset 0 0 0 1px rgba(0, 0, 0, 0.06);
		animation: n-pin 7s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
		animation-delay: calc(var(--j) * 0.35s);
	}
	.pin em {
		font-size: 9.5px;
		font-style: normal;
		color: #71717a;
	}
	.pin b {
		font-size: 14px;
		color: #18181b;
	}
	.pin i {
		font-size: 9.5px;
		font-style: normal;
		font-weight: 600;
		color: #15803d;
	}
	.pin i.down {
		color: #b91c1c;
	}
	@keyframes n-pin {
		0% { opacity: 0; transform: translateY(8px) scale(0.96); }
		8%, 92% { opacity: 1; transform: none; }
		100% { opacity: 0; }
	}
	.favs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
	}
	.fav {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 6px 8px;
		border-radius: 10px;
		background: linear-gradient(#f0fdf4, #fff);
		box-shadow: inset 0 0 0 1px rgba(45, 163, 30, 0.15);
	}
	.fav b {
		font-size: 10.5px;
		color: #3f3f46;
	}
	.bars {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 30px;
	}
	.bars i {
		flex: 1;
		height: var(--h);
		border-radius: 3px 3px 0 0;
		background: linear-gradient(#5fcf4d, #bbf7d0);
	}

	/* « Pourquoi ça bouge ? »: the change, part by part, then the AI's word on it. */
	.ex {
		display: flex;
		flex-direction: column;
		gap: 7px;
		width: 256px;
	}
	.ex-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
		font-size: 12px;
	}
	.ex-head b {
		color: #18181b;
	}
	.ex-head span {
		font-weight: 700;
		color: #15803d;
	}
	.part {
		display: grid;
		grid-template-columns: 70px 1fr 52px;
		align-items: center;
		gap: 6px;
		font-size: 11px;
	}
	.who {
		color: #3f3f46;
	}
	.track {
		height: 9px;
		border-radius: 999px;
		background: #f4f4f5;
		overflow: hidden;
	}
	.track i {
		display: block;
		width: var(--w);
		height: 100%;
		border-radius: 999px;
		background: linear-gradient(90deg, #86efac, #16a34a);
		transform-origin: left;
		animation: n-grow 7s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
		animation-delay: calc(var(--j) * 0.25s);
	}
	.track i.neg {
		background: linear-gradient(90deg, #fca5a5, #dc2626);
	}
	.by {
		text-align: right;
		font-weight: 700;
		color: #15803d;
	}
	.by.neg {
		color: #b91c1c;
	}
	@keyframes n-grow {
		0% { transform: scaleX(0); }
		12%, 100% { transform: scaleX(1); }
	}
	.why {
		margin-top: 2px !important;
		padding: 7px 10px;
		border-radius: 10px;
		background: linear-gradient(160deg, rgba(124, 58, 237, 0.08), #fff 70%);
		box-shadow: inset 0 0 0 1px rgba(124, 58, 237, 0.18);
		font-size: 11px;
		line-height: 1.4;
		color: #5b21b6;
		animation: n-say 7s ease-in-out infinite;
	}
	@keyframes n-say {
		0%, 25% { opacity: 0; transform: translateY(4px); }
		35%, 92% { opacity: 1; transform: none; }
		100% { opacity: 0; }
	}

	/* A chart drilled into: the way back grows step by step, the bars come anew. */
	.dr {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 10px;
		width: 250px;
	}
	.crumbs {
		display: flex;
		gap: 4px;
		font-size: 11.5px;
	}
	.crumbs b {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: #2a78d6;
		animation: n-crumb 8s ease-in-out infinite;
		animation-delay: calc(var(--j) * 1.2s);
	}
	.crumbs b:last-child {
		color: #18181b;
	}
	.crumbs em {
		font-style: normal;
		color: #a1a1aa;
	}
	@keyframes n-crumb {
		0% { opacity: 0; transform: translateX(-4px); }
		6%, 90% { opacity: 1; transform: none; }
		100% { opacity: 0; }
	}
	.cols {
		display: flex;
		align-items: flex-end;
		gap: 5px;
		height: 96px;
		padding-bottom: 2px;
		border-bottom: 1px solid #e4e4e7;
	}
	.cols i {
		flex: 1;
		height: var(--h);
		border-radius: 4px 4px 0 0;
		background: linear-gradient(#5b9be6, #c7dcf6);
		transform-origin: bottom;
		animation: n-rise 4s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
		animation-delay: calc(var(--j) * 0.04s);
	}
	.cols i.hot {
		background: linear-gradient(#2da31d, #a7e59c);
	}
	@keyframes n-rise {
		0% { transform: scaleY(0.1); }
		18%, 100% { transform: scaleY(1); }
	}
	.cursor {
		position: absolute;
		left: 46px;
		bottom: 34px;
		font-size: 18px;
		animation: n-tap 4s ease-in-out infinite;
	}
	@keyframes n-tap {
		0%, 70% { transform: none; }
		80% { transform: translateY(4px) scale(0.9); }
		90%, 100% { transform: none; }
	}

	/* Flows from a channel to a status, each lit in turn. */
	.fl {
		position: relative;
		width: 180px;
		/* Room for the names, drawn outside the flows. */
		padding: 0 72px;
		box-sizing: content-box;
	}
	.fl svg {
		display: block;
		overflow: visible;
	}
	.band {
		opacity: 0.28;
		animation: n-flow 6s ease-in-out infinite;
		animation-delay: calc(var(--k) * 0.18s);
	}
	@keyframes n-flow {
		0%, 100% { opacity: 0.26; }
		12% { opacity: 0.6; }
		30% { opacity: 0.3; }
	}
	.name {
		font-size: 13px;
		font-weight: 600;
		fill: #3f3f46;
	}

	/* A copilot that listens: the microphone, what it heard, the filters it set. */
	.vo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		width: 250px;
	}
	.mic {
		position: relative;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
	}
	.mic b {
		position: relative;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: linear-gradient(160deg, #8b5cf6, #6d28d9);
		font-size: 18px;
		box-shadow: 0 10px 24px -10px rgba(109, 40, 217, 0.7);
	}
	.mic i {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid rgba(139, 92, 246, 0.5);
		animation: n-listen 2.4s ease-out infinite;
	}
	.mic i + i {
		animation-delay: 1.2s;
	}
	@keyframes n-listen {
		0% { transform: scale(0.9); opacity: 0.9; }
		100% { transform: scale(1.9); opacity: 0; }
	}
	.heard {
		padding: 7px 12px;
		border-radius: 14px 14px 4px 14px;
		background: #f5f3ff;
		font-size: 12px;
		font-weight: 600;
		color: #4c1d95;
		animation: n-say 7s ease-in-out infinite;
		animation-delay: -1.2s;
	}
	.chips {
		display: flex;
		gap: 6px;
	}
	.chips b {
		padding: 3px 9px;
		border-radius: 999px;
		background: #fff;
		box-shadow: inset 0 0 0 1px rgba(124, 58, 237, 0.35);
		font-size: 11px;
		color: #6d28d9;
		animation: n-pin 7s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
		animation-delay: calc(1.6s + var(--j) * 0.3s);
	}

	/* Together: a mention that rings, a version to go back to. */
	.tg {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 256px;
	}
	.note {
		display: flex;
		align-items: flex-start;
		gap: 7px;
		padding: 8px 10px;
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 8px 20px -14px rgba(16, 40, 16, 0.5), inset 0 0 0 1px rgba(0, 0, 0, 0.06);
		font-size: 11.5px;
		line-height: 1.4;
		color: #3f3f46;
	}
	.note :global(b) {
		color: #2a78d6;
	}
	.note .who {
		flex: none;
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: #dcfce7;
		color: #15803d;
		font-size: 9px;
	}
	.notif {
		align-self: flex-end;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 6px 10px;
		border-radius: 10px;
		background: #eff6ff;
		color: #1e40af;
		font-size: 11px;
		font-weight: 600;
		animation: n-say 7s ease-in-out infinite;
	}
	.notif .bell {
		display: inline-block;
		transform-origin: 50% 10%;
		animation: n-bell 7s ease-in-out infinite;
	}
	@keyframes n-bell {
		0%, 34% { transform: rotate(0); }
		38% { transform: rotate(18deg); }
		42% { transform: rotate(-14deg); }
		46% { transform: rotate(8deg); }
		50%, 100% { transform: rotate(0); }
	}
	.ver {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 7px 10px;
		border-radius: 10px;
		background: #fafafa;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
		font-size: 11px;
		color: #52525b;
	}
	.ver .clock {
		color: #2da31d;
		font-weight: 700;
	}
	.ver b {
		margin-left: auto;
		padding: 2px 8px;
		border-radius: 999px;
		background: #2da31d;
		color: #fff;
		font-size: 10px;
	}

	@media (max-width: 980px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.art * {
			animation: none !important;
		}

---
/**
 * Forecasts: two years of monthly revenue, then the year to come — the measured curve draws
 * itself with the scroll, the forecast follows in green dashes, its 80 % band opening as it
 * goes further, and a tooltip lands on a forecast month.
 *
 * The figures are made up for the drawing (a trend, a season, a little noise); the forecast
 * is that same trend and season prolonged — what the application's Holt-Winters finds on
 * such a series. Progress is `--p` on the frame; without JavaScript, or asked for less
 * motion, everything is drawn. Drawn at 1080 × 480 and scaled to its frame.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, lang } = i18n(locale);
const f = t.forecast;

const N = 24;
const H = 12;
const truth = (i: number) => 120 + 2.6 * i + 26 * Math.sin((2 * Math.PI * (i - 3)) / 12);
const noise = (i: number) => (((i * 37) % 11) - 5) * 1.7;
const measured = Array.from({ length: N }, (_, i) => truth(i) + noise(i));
const ahead = Array.from({ length: H }, (_, k) => truth(N + k));
const spread = (k: number) => 6 + 3.4 * Math.sqrt(k + 1);

const W = 1032;
const X0 = 56;
const X1 = 1010;
const Y0 = 24;
const Y1 = 326;
const LO = 70;
const HI = 250;
const x = (i: number) => X0 + (i / (N + H - 1)) * (X1 - X0);
const y = (v: number) => Y1 - ((v - LO) / (HI - LO)) * (Y1 - Y0);
const line = (points: Array<[number, number]>) => points.map(([i, v], j) => `${j ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');

const last = measured[N - 1]!;
const measuredPath = line(measured.map((v, i) => [i, v]));
const measuredArea = `${measuredPath} L${x(N - 1).toFixed(1)} ${Y1} L${x(0).toFixed(1)} ${Y1} Z`;
const forecastPath = line([[N - 1, last], ...ahead.map((v, k): [number, number] => [N + k, v])]);
const upper = ahead.map((v, k): [number, number] => [N + k, v + spread(k)]);
const lower = ahead.map((v, k): [number, number] => [N + k, v - spread(k)]);
const band = `${line([[N - 1, last], ...upper])} ${[...lower].reverse().map(([i, v]) => `L${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ')} Z`;
const zone = { x: (x(N - 1) + x(N)) / 2, w: X1 - (x(N - 1) + x(N)) / 2 + 12 };

const money = new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR', notation: 'compact', maximumFractionDigits: 0 });
const month = (i: number, opts: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(lang, { ...opts, timeZone: 'UTC' }).format(new Date(Date.UTC(2025, i, 1)));
const grid = [100, 150, 200, 250].map((v) => ({ y: y(v), label: money.format(v * 1000) }));
const ticks = [0, 6, 12, 18, 24, 30, 35].map((i) => ({ x: x(i), label: month(i, { month: 'short', year: 'numeric' }) }));

// The tooltip, on a month of the coming year.
const TIP = 3;
const tip = {
	x: x(N + TIP),
	y: y(ahead[TIP]!),
	when: month(N + TIP, { month: 'long', year: 'numeric' }),
	value: money.format(ahead[TIP]! * 1000),
	range: `${money.format((ahead[TIP]! - spread(TIP)) * 1000)} – ${money.format((ahead[TIP]! + spread(TIP)) * 1000)}`,
};
const dots = ahead.map((v, k) => ({ x: x(N + k), y: y(v), k }));
---

<section class="tm-section night forecast" id="previsions" data-forecast>
	<div class="tm-head">
		<p class="tm-kicker tm-rise"><span class="new">{f.badge}</span>{f.kicker}</p>
		<h2 class="tm-display tm-rise">
			<span>{f.title}</span>
			<span class="tm-grad">{f.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{f.lede}</p>
	</div>

	<div class="frame" data-frame aria-hidden="true">
		<div class="card">
			<header class="c-head">
				<div>
					<p class="c-title">{f.chartTitle}</p>
					<p class="c-legend">
						<span><i class="sw measured"></i>{f.measured}</span>
						<span><i class="sw dashed"></i>{f.forecast}</span>
						<span><i class="sw band"></i>{f.band}</span>
					</p>
				</div>
				<div class="controls">
					<span class="ctl-label">{f.extend}</span>
					<span class="seg"><b>+3</b><b>+6</b><b class="on">+12</b></span>
					<span class="method">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72M14 7l3 3M5 6v4M19 14v4M10 2v2M7 8H3M21 16h-4M11 3H9"></path></svg>
						{f.method}
					</span>
				</div>
			</header>

			<div class="plot">
			<svg class="chart" viewBox={`0 0 ${W} 360`} width={W} height="360">
				<defs>
					<linearGradient id="fc-area" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color="#5aa0ff" stop-opacity="0.32"></stop>
						<stop offset="1" stop-color="#5aa0ff" stop-opacity="0"></stop>
					</linearGradient>
				</defs>
				{
					grid.map((g) => (
						<g>
							<line x1={X0} x2={X1} y1={g.y} y2={g.y} class="grid" />
							<text x={X0 - 10} y={g.y + 4} class="axis" text-anchor="end">
								{g.label}
							</text>
						</g>
					))
				}
				<line x1={X0} x2={X1} y1={Y1} y2={Y1} class="base" />
				{
					ticks.map((tk) => (
						<text x={tk.x} y={Y1 + 24} class="axis" text-anchor="middle">
							{tk.label}
						</text>
					))
				}

				<g class="zone">
					<rect x={zone.x} y={Y0 - 14} width={zone.w} height={Y1 - Y0 + 14} rx="10"></rect>
					<text x={zone.x + zone.w / 2} y={Y0 + 4} text-anchor="middle">{f.zone}</text>
				</g>

				<g class="measured">
					<path d={measuredArea} fill="url(#fc-area)"></path>
					<path d={measuredPath} class="m-line"></path>
				</g>

				<g class="ahead">
					<path d={band} class="band"></path>
					<path d={forecastPath} class="f-line"></path>
					{dots.map((d) => <circle cx={d.x} cy={d.y} r={d.k === TIP ? 6.5 : 3.5} class:list={['dot', { tip: d.k === TIP }]} />)}
				</g>
			</svg>

			<div class="bubble" style={`left:${tip.x + 14}px;top:${tip.y + 26}px`}>
				<p class="t-when">{tip.when} · <i>{f.tip}</i></p>
				<p class="t-value">{tip.value}</p>
				<p class="t-range">{f.range} : {tip.range}</p>
			</div>
			</div>
		</div>
	</div>

	<div class="tm-points">
		{
			f.points.map((p, i) => (
				<div class="tm-rise" style={`transition-delay:${i * 0.08}s`}>
					<span class="ic">
						{i === 0 && (
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-6 4-6 6 0s4 6 6 0 4-6 6 0" /><path d="M2 20h20" /></svg>
						)}
						{i === 1 && (
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11l4 4 8-8" /><path d="M13 15c2 1 5-1 8-4M13 15c2-2 5-4 8-4" stroke-dasharray="2 2.5" /></svg>
						)}
						{i === 2 && (
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M7 14l3-3 3 2 4-5" /><path d="M8 21h8" /></svg>
						)}
					</span>
					<h3>{p.title}</h3>
					<p>{p.text}</p>
				</div>
			))
		}
	</div>

	<p class="more tm-rise"><a class="tm-link" href={href('/fonctionnalites/previsions/')}>{f.link}</a></p>
</section>

<script>
	import { clamp, ease, fit, progress, reducedMotion } from '../../lib/motion';

	const frame = document.querySelector<HTMLElement>('[data-forecast] [data-frame]');
	if (frame) {
		fit(frame, 1080, 0.3);
		if (!reducedMotion()) {
			frame.style.setProperty('--p', '0');
			progress(frame, (p) => frame.style.setProperty('--p', ease(clamp(p / 0.9)).toFixed(4)), { mode: 'pass', start: 1, end: 0.7 });
		}
	}
</script>

<style>
	.forecast {
		overflow: hidden;
		background:
			radial-gradient(55% 40% at 70% 58%, rgba(66, 205, 42, 0.16), transparent 70%),
			radial-gradient(40% 35% at 25% 60%, rgba(90, 160, 255, 0.1), transparent 70%),
			var(--tm-night);
	}
	.new {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 0.72em;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #062b0c;
		background: #6ee08a;
	}
	.frame {
		--k: 1;
		--p: 1;
		position: relative;
		max-width: 1080px;
		height: calc(480px * var(--k));
		margin: 72px auto 0;
	}
	.card {
		position: absolute;
		top: 0;
		left: 50%;
		width: 1080px;
		height: 480px;
		padding: 24px 24px 0;
		border-radius: 26px;
		font-family: var(--bd-font-sans);
		color: #f4f4f5;
		background: linear-gradient(180deg, #17171a, #111113);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08),
			0 60px 140px -60px rgba(66, 205, 42, 0.35);
		transform: translateX(-50%) scale(var(--k));
		transform-origin: 50% 0;
	}
	.card p {
		margin: 0;
	}
	.c-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 18px;
	}
	.c-title {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -0.015em;
	}
	.c-legend {
		display: flex;
		gap: 18px;
		margin-top: 8px !important;
		font-size: 13px;
		color: #a1a1aa;
	}
	.c-legend span {
		display: inline-flex;
		align-items: center;
		gap: 7px;
	}
	.sw {
		display: inline-block;
		width: 18px;
		height: 0;
		border-top: 3px solid #5aa0ff;
		border-radius: 2px;
	}
	.sw.dashed {
		border-top: 3px dashed #42cd2a;
	}
	.sw.band {
		height: 10px;
		border: 0;
		background: rgba(66, 205, 42, 0.25);
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
		color: #a1a1aa;
	}
	.seg {
		display: inline-flex;
		gap: 2px;
		padding: 3px;
		border-radius: 10px;
		background: #27272a;
	}
	.seg b {
		padding: 5px 10px;
		border-radius: 7px;
		font-weight: 600;
		color: #a1a1aa;
	}
	.seg b.on {
		color: #f4f4f5;
		background: #3f3f46;
		box-shadow: inset 0 0 0 1px rgba(66, 205, 42, 0.6);
	}
	.method {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 11px;
		border-radius: 10px;
		color: #b5f0a8;
		background: rgba(66, 205, 42, 0.12);
	}
	.plot {
		position: relative;
	}
	.chart {
		display: block;
		overflow: visible;
	}
	.grid {
		stroke: #27272a;
		stroke-dasharray: 3 4;
	}
	.base {
		stroke: #3f3f46;
	}
	.axis {
		font-size: 12px;
		fill: #71717a;
	}
	.zone {
		opacity: clamp(0, calc((var(--p) - 0.45) * 4), 1);
	}
	.zone rect {
		fill: rgba(66, 205, 42, 0.07);
	}
	.zone text {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		fill: #42cd2a;
	}
	.measured {
		/* In SVG, the percentages are of the group's own box: the curve draws from left to right. */
		clip-path: inset(-6px calc((1 - min(1, var(--p) * 1.9)) * 100%) -6px 0);
	}
	.m-line {
		fill: none;
		stroke: #5aa0ff;
		stroke-width: 3;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.ahead {
		clip-path: inset(-20px calc((1 - clamp(0, (var(--p) - 0.5) * 2.3, 1)) * 100%) -20px 0);
	}
	.band {
		fill: rgba(66, 205, 42, 0.16);
	}
	.f-line {
		fill: none;
		stroke: #42cd2a;
		stroke-width: 3;
		stroke-dasharray: 9 7;
		stroke-linecap: round;
	}
	.dot {
		fill: #111113;
		stroke: #42cd2a;
		stroke-width: 2;
	}
	.dot.tip {
		fill: #42cd2a;
		stroke: #111113;
		stroke-width: 3;
	}
	.bubble {
		position: absolute;
		padding: 12px 14px;
		border-radius: 12px;
		font-size: 13px;
		color: #f4f4f5;
		background: #27272a;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08),
			0 16px 40px -12px rgba(0, 0, 0, 0.7);
		transform: translateY(calc((1 - clamp(0, (var(--p) - 0.88) * 9, 1)) * 10px));
		opacity: clamp(0, calc((var(--p) - 0.88) * 9), 1);
		white-space: nowrap;
	}
	.t-when {
		color: #a1a1aa;
	}
	.t-when i {
		color: #42cd2a;
		font-style: normal;
		font-weight: 600;
	}
	.t-value {
		margin-top: 4px !important;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.t-range {
		margin-top: 2px !important;
		font-size: 12px;
		color: #86efac;
	}
	.more {
		margin: 48px 0 0;
		text-align: center;
	}
</style>

---
/**
 * The AI assistant at work, on a loop while it is on screen — its screen as in the
 * application: the history on the left, the ring of light, the question typed in the input
 * (a source chosen), the steps ticking one by one, the chart arriving, the answer streamed.
 * Without JavaScript, or asked for less motion, everything is simply there.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, lang } = i18n(locale);
const a = t.assistant;
const max = Math.max(...a.bars.map((b) => b.value));
const number = new Intl.NumberFormat(lang);
---

<section class="tm-section night assistant" id="assistant" data-assistant>
	<div class="tm-head">
		<p class="tm-kicker tm-rise">
			<canvas class="orb" data-orb="20" width="30" height="30" aria-hidden="true"></canvas>
			{a.kicker}
		</p>
		<h2 class="tm-display tm-rise">
			<span>{a.title}</span>
			<span class="tm-grad">{a.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{a.lede}</p>
	</div>

	<div class="app tm-rise" data-app data-phase="done">
		<aside class="history" aria-hidden="true">
			<span class="new">+ {a.newChat}</span>
			<p class="group">{a.today}</p>
			{a.history.map((h, i) => <p class:list={['conv', { on: i === 0 }]}>{h}</p>)}
			<p class="group">{a.yesterday}</p>
			{a.older.map((h) => <p class="conv">{h}</p>)}
		</aside>

		<div class="main">
			<div class="grid-bg" aria-hidden="true"></div>
			<header class="top">
				<span class="model">
					<canvas class="orb" data-orb="16" data-busy-follow width="24" height="24" aria-hidden="true"></canvas>
					{a.model}
				</span>
			</header>

			<div class="thread">
				<p class="user" data-bubble>{a.ask}</p>
				<div class="bot">
					<canvas class="orb av" data-orb="26" data-busy-follow width="40" height="40" aria-hidden="true"></canvas>
					<div class="body">
						<p class="thinking">{a.thinking}</p>
						<ul class="steps">
							{
								a.steps.map((s) => (
									<li data-step>
										<span class="dot" aria-hidden="true">
											<i />
											<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										<span class="label">{s.label}</span>
										{s.detail ? <span class="detail">· {s.detail}</span> : null}
									</li>
								))
							}
						</ul>
						<div class="chart" data-chart>
							<div class="c-head">
								<div>
									<p class="c-title">{a.chartTitle}</p>
									<p class="c-sub">{a.chartSub}</p>
								</div>
								<span class="switch" aria-hidden="true">
									<i class="on">▤</i><i>▥</i><i>◔</i><i>▦</i>
								</span>
							</div>
							{
								a.bars.map((b, i) => (
									<div class="hb" style={`--w:${(b.value / max) * 100}%;--i:${i}`}>
										<span class="hb-label">{b.label}</span>
										<span class="hb-track">
											<i />
										</span>
										<span class="hb-val">
											{number.format(b.value)} {a.unit}
										</span>
									</div>
								))
							}
							<p class="c-foot">
								<span>{a.rows}</span>
								<b>{a.save} ›</b>
							</p>
						</div>
						<p class="answer" data-stream set:html={a.answer} />
					</div>
				</div>
			</div>

			<div class="composer">
				<p class="input" data-type data-placeholder={a.placeholder}></p>
				<div class="bar">
					<span class="source">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path></svg>
						{a.sources}
					</span>
					<span class="send" aria-hidden="true">↑</span>
				</div>
			</div>
		</div>
	</div>

	<ul class="points">
		{
			a.points.map((p, i) => (
				<li class="tm-rise" style={`transition-delay:${i * 0.08}s`}>
					<b>{p.title}</b>
					<span>{p.text}</span>
				</li>
			))
		}
	</ul>
	<p class="providers tm-rise">{a.providers}</p>
	<p class="more tm-rise">
		<a class="tm-link" href={href('/fonctionnalites/assistant/')}>{a.link}</a>
		<a class="tm-link" href={href('/fonctionnalites/copilot/')}>{a.linkCopilot}</a>
	</p>
</section>

<script>
	import { reducedMotion, whileVisible } from '../../lib/motion';

	/**
	 * The assistant's ring of light, as in the application: a thin wavering stroke, several
	 * offset outlines, a highlight that turns; livelier while it works.
	 */
	const orbs = [...document.querySelectorAll<HTMLCanvasElement>('[data-assistant] [data-orb]')];
	const state = { busy: false }
	const still = reducedMotion();
	const drawn = orbs.map((el) => {
		const size = Number(el.dataset.orb);
		const box = size * 1.5;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		el.width = Math.round(box * dpr);
		el.height = Math.round(box * dpr);
		el.style.width = `${box}px`;
		el.style.height = `${box}px`;
		const ctx = el.getContext('2d');
		ctx?.scale(dpr, dpr);
		return { el, ctx, size, box, follows: el.hasAttribute('data-busy-follow'), t: Math.random() * 10, speed: 1 };
	});
	const paint = (o: (typeof drawn)[number]) => {
		const { ctx, size, box } = o;
		if (!ctx) return;
		const small = size < 40;
		const busy = o.follows && state.busy;
		const cx = box / 2;
		const R = size / 2 - Math.max(1.5, size * 0.04);
		ctx.clearRect(0, 0, box, box);
		for (let k = 0; k < (small ? 2 : 3); k++) {
			const amp = (busy ? 0.06 : 0.035) * (1 - k * 0.2);
			ctx.beginPath();
			for (let i = 0; i <= 64; i++) {
				const ang = (i / 64) * Math.PI * 2;
				const w = Math.sin(3 * ang + o.t * 1.3 + k * 1.7) * 0.5 + Math.sin(5 * ang - o.t * 0.9 + k * 2.3) * 0.3 + Math.sin(2 * ang + o.t * 0.6 + k) * 0.2;
				const r = R * (1 + amp * w) - k * R * 0.012;
				const x = cx + r * Math.cos(ang);
				const y = cx + r * Math.sin(ang);
				if (i === 0) ctx.moveTo(x, y);
				else ctx.lineTo(x, y);
			}
			ctx.closePath();
			const g = ctx.createConicGradient(o.t * 0.55 + k * 0.9, cx, cx);
			g.addColorStop(0, 'rgba(34,211,238,1)');
			g.addColorStop(0.28, 'rgba(20,184,166,1)');
			g.addColorStop(0.5, 'rgba(255,255,255,0.95)');
			g.addColorStop(0.62, 'rgba(34,211,238,0.15)');
			g.addColorStop(0.8, 'rgba(139,92,246,0.55)');
			g.addColorStop(1, 'rgba(34,211,238,1)');
			ctx.strokeStyle = g;
			ctx.lineWidth = Math.max(1.1, size * (small ? 0.075 : 0.032)) * (1 - k * 0.3);
			ctx.globalAlpha = 0.95 - k * 0.3;
			ctx.shadowColor = 'rgba(34,211,238,0.65)';
			ctx.shadowBlur = size * (small ? 0.25 : 0.18);
			ctx.stroke();
		}
		ctx.globalAlpha = 1;
	};
	let last = performance.now();
	const frame = (now: number) => {
		const dt = Math.min((now - last) / 1000, 0.05);
		last = now;
		for (const o of drawn) {
			o.speed += ((o.follows && state.busy ? 2.6 : 1) - o.speed) * Math.min(dt * 3, 1);
			o.t += dt * o.speed;
			paint(o);
		}
		requestAnimationFrame(frame);
	};
	if (still) for (const o of drawn) paint(o);
	else requestAnimationFrame(frame);

	const section = document.querySelector<HTMLElement>('[data-assistant]');
	const app = section?.querySelector<HTMLElement>('[data-app]');
	const typed = app?.querySelector<HTMLElement>('[data-type]');
	const bubble = app?.querySelector<HTMLElement>('[data-bubble]');
	const stream = app?.querySelector<HTMLElement>('[data-stream]');
	const steps = [...(app?.querySelectorAll<HTMLElement>('[data-step]') ?? [])];

	if (section && app && typed && bubble && stream && !still) {
		const question = bubble.textContent ?? '';
		// The answer, word by word: each word of its text (bold ones included) in its own span.
		const words: HTMLElement[] = [];
		const split = (node: Node) => {
			for (const child of [...node.childNodes]) {
				if (child.nodeType === Node.TEXT_NODE) {
					const frag = document.createDocumentFragment();
					for (const part of (child.textContent ?? '').split(/(\s+)/)) {
						if (part === '') continue;
						if (/^\s+$/.test(part)) {
							frag.append(part);
							continue;
						}
						const span = document.createElement('span');
						span.className = 'w';
						span.textContent = part;
						words.push(span);
						frag.append(span);
					}
					child.replaceWith(frag);
				} else split(child);
			}
		};
		split(stream);

		const round = async (sleep: (ms: number) => Promise<void>) => {
			app.dataset.phase = 'typing';
			typed.textContent = '';
			for (const s of steps) s.removeAttribute('data-state');
			for (const w of words) w.classList.remove('on');
			await sleep(700);
			for (let i = 1; i <= question.length; i++) {
				typed.textContent = question.slice(0, i);
				await sleep(question[i - 1] === ' ' ? 38 : 20);
			}
			await sleep(450);
			typed.textContent = '';
			app.dataset.phase = 'steps';
			state.busy = true;
			await sleep(700);
			for (const s of steps) {
				s.dataset.state = 'run';
				await sleep(800);
				s.dataset.state = 'ok';
				await sleep(120);
			}
			app.dataset.phase = 'chart';
			await sleep(1300);
			app.dataset.phase = 'answer';
			for (const w of words) {
				w.classList.add('on');
				await sleep(55);
			}
			state.busy = false;
			app.dataset.phase = 'done';
		};

		whileVisible(
			section,
			async (sleep) => {
				for (;;) {
					await round(sleep);
					await sleep(7000);
				}
			},
			0.3,
		);
	}
</script>

<style>
	.assistant {
		overflow: hidden;
	}
	.tm-kicker .orb {
		width: 30px;
		height: 30px;
		margin: -5px -2px -5px -6px;
		vertical-align: middle;
	}
	.app {
		position: relative;
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr);
		max-width: 1080px;
		height: 720px;
		margin: 72px auto 0;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 26px;
		background: #0c0e0d;
		box-shadow:
			0 60px 120px -50px rgba(34, 211, 238, 0.28),
			0 30px 80px -40px rgba(63, 203, 42, 0.25);
	}
	.history {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 16px 12px;
		border-right: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(255, 255, 255, 0.02);
		font-size: 13px;
	}
	.history p {
		margin: 0;
	}
	.new {
		margin-bottom: 14px;
		padding: 9px 14px;
		border-radius: 12px;
		font-size: 13px;
		font-weight: 600;
		color: #0b0d0c;
		background: #42cd2a;
	}
	.group {
		margin: 10px 8px 4px !important;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #6b6f6c;
	}
	.conv {
		padding: 8px 10px;
		border-radius: 9px;
		color: #9a9e9b;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.conv.on {
		color: #f5f5f7;
		background: rgba(255, 255, 255, 0.07);
		box-shadow: inset 2px 0 0 #42cd2a;
	}
	.main {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		background: radial-gradient(60% 40% at 50% 0%, rgba(66, 205, 42, 0.1), transparent 70%);
	}
	.grid-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
		background-size: 40px 40px;
		-webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 20%, transparent 75%);
		mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 20%, transparent 75%);
	}
	.top {
		position: relative;
		display: flex;
		padding: 14px 18px;
	}
	.model {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 12px 4px 4px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		font-size: 12px;
		color: #d4d4d8;
		background: rgba(255, 255, 255, 0.03);
	}
	.model .orb {
		margin: -4px -2px;
	}
	.thread {
		position: relative;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 22px;
		min-height: 0;
		padding: 6px 48px 0;
		overflow: hidden;
	}
	.user {
		align-self: flex-end;
		max-width: 75%;
		margin: 0;
		padding: 12px 18px;
		border-radius: 22px 22px 6px 22px;
		font-size: 15.5px;
		line-height: 1.5;
		color: #f5f5f7;
		background: #262a28;
		transition:
			opacity 0.4s ease,
			transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.bot {
		display: flex;
		gap: 14px;
	}
	.av {
		flex-shrink: 0;
		margin: -6px -2px 0 -6px;
	}
	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 14px;
		min-width: 0;
	}
	.thinking {
		margin: 0;
		font-size: 14px;
		font-weight: 500;
		background: linear-gradient(90deg, #6b6f6c 0%, #f5f5f7 50%, #6b6f6c 100%);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: as-shimmer 1.8s linear infinite;
		display: none;
	}
	.app[data-phase='steps'] .thinking {
		display: block;
	}
	.app[data-phase='steps'] .steps li:first-child:not([data-state]) ~ * {
		display: none;
	}
	@keyframes as-shimmer {
		to {
			background-position: -200% 0;
		}
	}
	.steps {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.steps li {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 11px;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 999px;
		font-size: 12.5px;
		color: #a1a1a6;
		background: rgba(255, 255, 255, 0.03);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}
	.detail {
		color: #6b6f6c;
	}
	.dot {
		display: grid;
		place-items: center;
		width: 14px;
		height: 14px;
		color: #42cd2a;
	}
	.dot > * {
		grid-area: 1 / 1;
	}
	.dot i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #42cd2a;
		opacity: 0;
		animation: as-pulse 0.9s ease-in-out infinite;
	}
	[data-state='run'] .dot i {
		opacity: 1;
	}
	[data-state='run'] .dot svg {
		opacity: 0;
	}
	[data-state='run'] .label {
		background: linear-gradient(90deg, #6b6f6c 0%, #f5f5f7 50%, #6b6f6c 100%);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: as-shimmer 1.8s linear infinite;
	}
	@keyframes as-pulse {
		50% {
			transform: scale(0.6);
			opacity: 0.5;
		}
	}
	.app:is([data-phase='typing']) .user,
	.app:is([data-phase='typing']) .bot {
		opacity: 0;
		transform: translateY(10px);
	}
	.app[data-phase='typing'] .bot {
		transition: none;
	}
	.bot {
		transition: opacity 0.4s ease;
	}
	.app[data-phase='steps'] .steps li:not([data-state]) {
		opacity: 0;
		transform: translateY(4px);
	}
	.chart {
		display: flex;
		flex-direction: column;
		gap: 9px;
		padding: 16px 18px 12px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.035);
		transition:
			opacity 0.5s ease,
			transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.app:is([data-phase='typing'], [data-phase='steps']) .chart {
		opacity: 0;
		transform: translateY(14px);
	}
	.c-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 4px;
	}
	.c-title {
		margin: 0;
		font-size: 14px;
		font-weight: 600;
		color: #f5f5f7;
	}
	.c-sub {
		margin: 2px 0 0;
		font-size: 12px;
		color: #6b6f6c;
	}
	.switch {
		display: flex;
		gap: 2px;
		padding: 2px;
		border-radius: 9px;
		background: rgba(255, 255, 255, 0.05);
	}
	.switch i {
		display: grid;
		place-items: center;
		width: 24px;
		height: 22px;
		border-radius: 7px;
		font-size: 12px;
		font-style: normal;
		color: #6b6f6c;
	}
	.switch i.on {
		color: #f5f5f7;
		background: rgba(255, 255, 255, 0.1);
	}
	.hb {
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr) 50px;
		align-items: center;
		gap: 12px;
		font-size: 13px;
	}
	.hb-label {
		color: #a1a1a6;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.hb-track {
		height: 11px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.05);
		overflow: hidden;
	}
	.hb-track i {
		display: block;
		width: var(--w);
		height: 100%;
		border-radius: 6px;
		background: linear-gradient(90deg, #14b8a6, #22d3ee);
		transform-origin: left;
		transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.15s + var(--i) * 0.08s);
	}
	.app:is([data-phase='typing'], [data-phase='steps']) .hb-track i {
		transform: scaleX(0);
	}
	.hb-val {
		text-align: right;
		font-weight: 600;
		color: #f5f5f7;
		font-variant-numeric: tabular-nums;
	}
	.c-foot {
		display: flex;
		justify-content: space-between;
		margin: 6px 0 0;
		padding-top: 10px;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		font-size: 11.5px;
		color: #6b6f6c;
	}
	.c-foot b {
		font-weight: 600;
		color: #d4d4d8;
	}
	.answer {
		margin: 0;
		font-size: 15.5px;
		line-height: 1.6;
		color: #e4e4e7;
	}
	.answer :global(b) {
		color: #c9f06b;
	}
	.answer :global(.w) {
		opacity: 0;
		filter: blur(4px);
		transition:
			opacity 0.35s ease,
			filter 0.35s ease;
	}
	.answer :global(.w.on),
	.app[data-phase='done'] .answer :global(.w) {
		opacity: 1;
		filter: none;
	}
	.composer {
		position: relative;
		margin: 14px 48px 20px;
		padding: 1px;
		border-radius: 24px;
		background: linear-gradient(90deg, rgba(66, 205, 42, 0.7), rgba(34, 211, 238, 0.7), rgba(139, 92, 246, 0.7));
		box-shadow: 0 12px 40px -16px rgba(34, 211, 238, 0.45);
	}
	.composer > * {
		background: #111413;
	}
	.input {

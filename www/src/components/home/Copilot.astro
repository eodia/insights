---
/**
 * The Copilot at work, on a loop while it is on screen: the question typed, the tools it
 * calls (each one turning from a spinner to a tick), the answer streamed word by word, and
 * the chart it drew. Without JavaScript, or asked for less motion, everything is simply
 * there.
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, lang } = i18n(locale);
const c = t.copilot;
const max = Math.max(...c.bars.map((b) => b.value));
const number = new Intl.NumberFormat(lang);
---

<section class="tm-section night copilot" data-copilot>
	<div class="tm-head">
		<p class="tm-kicker tm-rise">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M19 3v4M17 5h4"></path></svg>
			{c.kicker}
		</p>
		<h2 class="tm-display tm-rise">
			<span>{c.title}</span>
			<span class="tm-grad">{c.titleAccent}</span>
		</h2>
		<p class="tm-lede tm-rise">{c.lede}</p>
	</div>

	<div class="chat tm-rise" data-chat data-phase="done">
		<div class="glow" aria-hidden="true"></div>
		<div class="msg user">
			<span class="avatar">AM</span>
			<p data-type>{c.ask}</p>
		</div>

		<div class="msg bot">
			<span class="avatar bot-av" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path></svg>
			</span>
			<div class="bot-body">
				<ul class="tools">
					{
						c.thinking.map((step) => (
							<li data-tool>
								<span class="state" aria-hidden="true">
									<i class="spin" />
									<svg class="ok" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
								</span>
								<code>{step.tool}</code>
								<span class="arg">{step.text}</span>
							</li>
						))
					}
				</ul>
				<p class="answer" data-stream set:html={c.answer} />
				<div class="chart" data-chart>
					<p class="chart-title">{c.chartTitle}</p>
					{
						c.bars.map((b, i) => (
							<div class="hb" style={`--w:${(b.value / max) * 100}%;--i:${i}`}>
								<span class="hb-label">{b.label}</span>
								<span class="hb-track">
									<i />
								</span>
								<span class="hb-val">
									{number.format(b.value)} {c.unit}
								</span>
							</div>
						))
					}
					<span class="save">{c.apply}</span>
				</div>
			</div>
		</div>
	</div>

	<p class="providers tm-rise">{c.providers}</p>
	<p class="more tm-rise"><a class="tm-link" href={href('/fonctionnalites/copilot/')}>{c.link}</a></p>
</section>

<script>
	import { reducedMotion, whileVisible } from '../../lib/motion';

	const section = document.querySelector<HTMLElement>('[data-copilot]');
	const chat = section?.querySelector<HTMLElement>('[data-chat]');
	const typed = chat?.querySelector<HTMLElement>('[data-type]');
	const stream = chat?.querySelector<HTMLElement>('[data-stream]');
	const tools = [...(chat?.querySelectorAll<HTMLElement>('[data-tool]') ?? [])];

	if (section && chat && typed && stream && !reducedMotion()) {
		const question = typed.textContent ?? '';
		// The answer, word by word: each word of its text (bold ones included) in its own span.
		const words: HTMLElement[] = [];
		const split = (node: Node) => {
			for (const child of [...node.childNodes]) {
				if (child.nodeType === Node.TEXT_NODE) {
					const parts = (child.textContent ?? '').split(/(\s+)/);
					const frag = document.createDocumentFragment();
					for (const part of parts) {
						if (part === '') continue;
						if (/^\s+$/.test(part)) {
							frag.append(part);
							continue;
						}
						const span = document.createElement('span');
						span.className = 'w';
						span.textContent = part;
						words.push(span);
						frag.append(span);
					}
					child.replaceWith(frag);
				} else {
					split(child);
				}
			}
		};
		split(stream);

		/** One round: the question typed, the tools called, the answer streamed, the chart. */
		const round = async (sleep: (ms: number) => Promise<void>) => {
			chat.dataset.phase = 'typing';
			typed.textContent = '';
			for (const t of tools) t.removeAttribute('data-state');
			for (const w of words) w.classList.remove('on');
			await sleep(600);
			for (let i = 1; i <= question.length; i++) {
				typed.textContent = question.slice(0, i);
				await sleep(question[i - 1] === ' ' ? 40 : 22);
			}
			await sleep(400);
			chat.dataset.phase = 'tools';
			for (const t of tools) {
				t.dataset.state = 'run';
				await sleep(750);
				t.dataset.state = 'ok';
				await sleep(120);
			}
			chat.dataset.phase = 'answer';
			for (const w of words) {
				w.classList.add('on');
				await sleep(55);
			}
			await sleep(250);
			chat.dataset.phase = 'done';
		};

		whileVisible(
			section,
			async (sleep) => {
				for (;;) {
					await round(sleep);
					await sleep(7000);
				}
			},
			0.35,
		);
	}
</script>

<style>
	.copilot {
		overflow: hidden;
	}
	.chat {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 22px;
		max-width: 820px;
		margin: 72px auto 0;
		padding: 32px;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 28px;
		background: linear-gradient(180deg, #121614, #0b0d0c);
		box-shadow: 0 60px 120px -50px rgba(63, 203, 42, 0.35);
	}
	.glow {
		position: absolute;
		inset: -1px;
		border-radius: inherit;
		padding: 1px;
		background: conic-gradient(from var(--a, 0deg), transparent 0 70%, #5fe07a 82%, #c9f06b 88%, transparent 96%);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		opacity: 0;
		transition: opacity 0.6s ease;
		pointer-events: none;
		animation: cp-turn 3s linear infinite;
	}
	.chat:is([data-phase='tools'], [data-phase='answer']) .glow {
		opacity: 1;
	}
	@property --a {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}
	@keyframes cp-turn {
		to {
			--a: 360deg;
		}
	}

	.msg {
		display: flex;
		gap: 14px;
	}
	.msg.user {
		flex-direction: row-reverse;
	}
	.avatar {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		font-size: 12px;
		font-weight: 700;
		color: #fff;
		background: linear-gradient(135deg, #f472b6, #8b5cf6);
	}
	.bot-av {
		color: #0b0d0c;
		background: var(--tm-grad-night);
	}
	.user p {
		min-height: 1.5em;
		max-width: 560px;
		margin: 0;
		padding: 14px 18px;
		border-radius: 20px 20px 6px 20px;
		font-size: 17px;
		line-height: 1.5;
		color: #fff;
		background: #2a2d2b;
	}
	.chat[data-phase='typing'] .user p::after {
		content: '';
		display: inline-block;
		width: 2px;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: -0.2em;
		background: #6ee08a;
		animation: cp-blink 0.9s steps(1) infinite;
	}
	@keyframes cp-blink {
		50% {
			opacity: 0;
		}
	}
	.bot-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 16px;
		min-width: 0;
	}
	.tools {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tools li {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
		color: #a1a1a6;
		transition: opacity 0.3s ease;
	}
	.chat[data-phase='typing'] .tools li,
	.chat[data-phase='tools'] .tools li:not([data-state]) {
		opacity: 0;
	}
	.tools code {
		padding: 3px 9px;
		border-radius: 7px;
		font-size: 12.5px;
		color: #6ee08a;
		background: rgba(110, 224, 138, 0.1);
	}
	.arg {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.state {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: rgba(110, 224, 138, 0.16);
		color: #6ee08a;
	}
	.state > * {
		grid-area: 1 / 1;
	}
	.spin {
		width: 12px;
		height: 12px;
		border: 2px solid rgba(110, 224, 138, 0.25);
		border-top-color: #6ee08a;
		border-radius: 50%;
		opacity: 0;
		animation: cp-spin 0.7s linear infinite;
	}
	[data-state='run'] .spin {
		opacity: 1;
	}
	[data-state='run'] .ok {
		opacity: 0;
	}
	@keyframes cp-spin {
		to {
			transform: rotate(360deg);
		}
	}
	.answer {
		margin: 0;
		font-size: 18px;
		line-height: 1.55;
		color: #e8e8ed;
	}
	.answer :global(b) {
		color: #c9f06b;
	}
	.answer :global(.w) {
		opacity: 0;
		filter: blur(4px);
		transition:
			opacity 0.35s ease,
			filter 0.35s ease;
	}
	.answer :global(.w.on),
	.chat[data-phase='done'] .answer :global(.w) {
		opacity: 1;
		filter: none;
	}
	.chart {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px 22px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.03);
		transition:
			opacity 0.5s ease,
			transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.chat:not([data-phase='done']) .chart {
		opacity: 0;
		transform: translateY(14px);
	}
	.chart-title {
		margin: 0 0 4px;
		font-size: 14px;
		font-weight: 600;
		color: #f5f5f7;
	}
	.hb {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr) 54px;
		align-items: center;
		gap: 12px;
		font-size: 13.5px;
	}
	.hb-label {
		color: #a1a1a6;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.hb-track {
		height: 12px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.05);
		overflow: hidden;
	}
	.hb-track i {
		display: block;
		width: var(--w);
		height: 100%;
		border-radius: 6px;
		background: var(--tm-grad-night);
		transform-origin: left;
		transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.15s + var(--i) * 0.08s);
	}
	.chat:not([data-phase='done']) .hb-track i {
		transform: scaleX(0);
	}
	.hb-val {
		text-align: right;
		font-weight: 600;
		color: #f5f5f7;
		font-variant-numeric: tabular-nums;
	}
	.save {
		align-self: flex-start;
		margin-top: 8px;
		padding: 8px 14px;
		border-radius: 999px;
		font-size: 13.5px;
		font-weight: 600;
		color: #0b0d0c;
		background: #6ee08a;
	}
	.providers {
		max-width: 640px;
		margin: 36px auto 0;
		text-align: center;
		font-size: 15px;
		color: var(--tm-night-slate);
	}
	.more {
		margin: 18px 0 0;
		text-align: center;
	}

	@media (max-width: 640px) {
		.chat {
			padding: 20px 16px;
		}
		.msg {
			gap: 10px;
		}
		.avatar {
			width: 30px;
			height: 30px;
		}
		.user p,
		.answer {
			font-size: 15.5px;
		}
		.hb {
			grid-template-columns: 96px minmax(0, 1fr) 46px;
			font-size: 12.5px;
		}
		.tools li {
			font-size: 13px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.glow,
		.spin {
			animation: none;
		}
	}
</style>

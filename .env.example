# eodia insights — configuration locale.
# Copiez ce fichier en `.env` à la racine du dépôt : l'API, le worker, le serveur MCP, le web et
# docker compose le lisent tous. Une variable déjà présente dans l'environnement (Docker, CI,
# .vscode/launch.json) l'emporte toujours. `.env.local`, s'il existe, l'emporte sur `.env`.
# Les valeurs commentées sont les valeurs par défaut du développement.

# ── Copilote IA ──────────────────────────────────────────────────────────────
# Le copilote s'active dès qu'une clé est présente. Fournisseur détecté d'après la clé fournie,
# ou forcé par AI_PROVIDER : anthropic | openai | mistral | openai-compatible | none.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=anthropic
# Clé générique, prioritaire sur les deux précédentes (utile pour mistral ou un serveur compatible).
# AI_API_KEY=
# Modèle : claude-sonnet-5-5 par défaut avec Anthropic, gpt-4.1 avec OpenAI, mistral-large-latest avec Mistral.
# AI_MODEL=claude-sonnet-5-5
# Obligatoire pour openai-compatible (vLLM, Ollama, LiteLLM…) ; facultatif sinon.
# AI_BASE_URL=https://api.example.com/v1
# Appels au copilote par personne et par heure.
# AI_HOURLY_QUOTA=60

# ── Trino et point de décision OPA ───────────────────────────────────────────
# Lu par docker compose : l'adresse à laquelle Trino joint l'endpoint OPA de l'API.
# Port 4300 = API lancée depuis .vscode/launch.json ; 4100 = `pnpm --filter @eodia/api dev`.
# Après modification : docker compose up -d trino
OPA_URL=http://host.docker.internal:4300/internal/opa/dev-opa-secret
# Secret dans le chemin de l'endpoint OPA : doit correspondre à la fin de OPA_URL.
# OPA_SECRET=dev-opa-secret
# TRINO_URL=http://localhost:58080
# TRINO_SERVICE_USER=eodia-service
# TRINO_PASSWORD=
# Hôte que Trino (dans Docker) utilise à la place de `localhost` pour joindre vos bases.
# TRINO_LOCALHOST_ALIAS=host.docker.internal

# ── Catalogue et sécurité ────────────────────────────────────────────────────
# DATABASE_URL=postgres://eodia:eodia@localhost:55435/eodia
# DATABASE_SCHEMA=eodia
# Chiffre les secrets des sources (64 caractères hexadécimaux). Obligatoire en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRET_KEY=
# SESSION_DAYS=14

# ── Adresses ─────────────────────────────────────────────────────────────────
# Adresse publique de l'application (liens de partage, invitations, OIDC).
# PUBLIC_URL=http://localhost:3100
# Port de l'API, et adresse de l'API vue par le web (relais /api/*) et par le serveur MCP.
# API_PORT=4100
# API_URL=http://localhost:4100
# MCP_PORT=4200

# ── Requêtes et cache ────────────────────────────────────────────────────────
# MAX_ROWS=2000
# QUERY_TIMEOUT_MS=120000
# Durée de cache des résultats, en secondes.
# CACHE_TTL=300

# ── Connexion SSO (OIDC) ─────────────────────────────────────────────────────
# OIDC_ISSUER=https://keycloak.example.com/realms/eodia
# OIDC_CLIENT_ID=eodia-insights
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Se connecter avec SSO
# OIDC_SCOPES=openid email profile
# Claims copiées en attributs utilisateur (règles de ligne {{user.region}}…), séparées par des virgules.
# OIDC_ATTRIBUTE_CLAIMS=region,departement
# Claim de groupes à refléter sur les groupes du même nom.
# OIDC_GROUPS_CLAIM=groups
# Connexion par mot de passe (0 pour ne garder que le SSO).
# PASSWORD_LOGIN=1

# ── E-mails (invitations) ────────────────────────────────────────────────────
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.example.com:587
# SMTP_FROM=eodia insights <noreply@example.com>

# ── Développement ────────────────────────────────────────────────────────────
# Instance de démonstration (comptes et sources d'exemple) et worker dans le processus de l'API.
# DEMO=1
# INPROCESS_WORKER=1

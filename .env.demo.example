# Démo publique d'eodia insights — copiez ce fichier en .env à côté de docker-compose.demo.yml.
DOMAIN=demo.exemple.fr
SECRET_KEY=          # openssl rand -hex 32
OPA_SECRET=          # openssl rand -hex 24
ACME_EMAIL=

# Derrière un proxy existant (nginx, Traefik…) qui gère déjà le HTTPS : Caddy sert en HTTP
# sur un port local, et le proxy lui relaie tout le domaine.
# CADDY_SITE=:80
# HTTP_PORT=127.0.0.1:8088
# HTTPS_PORT=127.0.0.1:8443

# L'assistant IA (facultatif) : sans clé, il est désactivé.
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_HOURLY_QUOTA=30

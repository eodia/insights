# Caddy devant eodia insights : HTTPS automatique (Let's Encrypt) pour DOMAIN, puis
#   /api/*  → API (REST, auth, copilot en SSE)
#   /mcp    → serveur MCP (Streamable HTTP)
#   le reste → interface web
#
# L'endpoint OPA interne (/internal/opa/…) n'est volontairement PAS exposé : seul Trino
# l'appelle, sur le réseau Docker.

{
	# Adresse de contact pour les certificats (les fichiers compose donnent admin@DOMAIN par défaut).
	email {$ACME_EMAIL:}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Même un ancien client ne voit jamais le point de décision de Trino.
	respond /internal/* 404

	handle /api/* {
		# Le copilot et la progression des synchros parlent en SSE : rien ne doit tamponner.
		reverse_proxy api:4100 {
			flush_interval -1
		}
	}

	handle /mcp* {
		reverse_proxy mcp:4200 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3100
	}
}
